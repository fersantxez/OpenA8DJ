[OpenA8DJUsb.Interface]

[Strings]
ProviderName="OpenA8DJ"
ManufacturerName="OpenA8DJ"
DiskName="OpenA8DJ Windows Driver Package"
DeviceName="OpenA8DJ USB Transport for Native Instruments Audio 8 DJ"
ServiceName="OpenA8DJ USB Transport Driver"
SPSVCINST_ASSOCSERVICE=0x00000002

