[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ProviderName%
DriverVer=06/08/2026,0.0.1.0
CatalogFile=OpenA8DJUsb.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13
OpenA8DJUsb.CopyFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
OpenA8DJUsb.sys=1

[Manufacturer]
%ManufacturerName%=OpenA8DJ,NTamd64.10.0,NTarm64.10.0

[OpenA8DJ.NTamd64.10.0]
%DeviceName%=OpenA8DJUsb.Install, USB\VID_17CC&PID_1978

[OpenA8DJ.NTarm64.10.0]
%DeviceName%=OpenA8DJUsb.Install, USB\VID_17CC&PID_1978

[OpenA8DJUsb.Install.NT]
CopyFiles=OpenA8DJUsb.CopyFiles

[OpenA8DJUsb.CopyFiles]
OpenA8DJUsb.sys

[OpenA8DJUsb.Install.NT.Services]
AddService=OpenA8DJUsb,%SPSVCINST_ASSOCSERVICE%,OpenA8DJUsb.Service

[OpenA8DJUsb.Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenA8DJUsb.sys

[OpenA8DJUsb.Install.NT.Wdf]
KmdfService=OpenA8DJUsb,OpenA8DJUsb.Wdf

[OpenA8DJUsb.Wdf]
KmdfLibraryVersion=1.15

[OpenA8DJUsb.Install.NT.Interfaces]
