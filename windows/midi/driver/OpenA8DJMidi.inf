AddInterface=%KSCATEGORY_RENDER%,%MidiReference%,OpenA8DJMidi_Interface
AddInterface=%KSCATEGORY_CAPTURE%,%MidiReference%,OpenA8DJMidi_Interface

[OpenA8DJMidi_Interface]
AddReg=OpenA8DJMidi_Interface_AddReg

[OpenA8DJMidi_Interface_AddReg]
HKR,,CLSID,,%KSProxy.CLSID%
HKR,,FriendlyName,,%OpenA8DJMidi.FriendlyName%

[DestinationDirs]
