[OpenA8DJMidi_Service]
DisplayName=%OpenA8DJMidi.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenA8DJMidi.sys
LoadOrderGroup=Base

[OpenA8DJMidi_Install.Interfaces]
