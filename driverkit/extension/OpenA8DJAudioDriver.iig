#ifndef OPENA8DJ_AUDIO_DRIVER_IIG
#define OPENA8DJ_AUDIO_DRIVER_IIG

#include <AudioDriverKit/AudioDriverKit.h>
#include <DriverKit/IOService.iig>

class OpenA8DJAudioDriver : public IOUserAudioDriver
{
public:
  virtual bool init() override;
  virtual void free() override;
  virtual kern_return_t Start(IOService* provider) override;
  virtual kern_return_t Stop(IOService* provider) override;
  virtual kern_return_t NewUserClient(uint32_t type, IOUserClient** user_client) override;
  virtual kern_return_t StartDevice(IOUserAudioObjectID object_id,
                                    IOUserAudioStartStopFlags flags) override;
  virtual kern_return_t StopDevice(IOUserAudioObjectID object_id,
                                   IOUserAudioStartStopFlags flags) override;
};

#endif
