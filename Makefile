		--pair "$(CHANNEL_MATRIX_PAIR)" --rate "$(CHANNEL_MATRIX_RATE)" \
		--seconds "$(CHANNEL_MATRIX_SECONDS)" --peak "$(CHANNEL_MATRIX_PEAK)"

