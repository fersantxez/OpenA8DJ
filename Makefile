$(HAL_FLAGS_STAMP): FORCE
	@mkdir -p build
	@tmp="$@.tmp"; printf '%s\n' '$(HAL_CFLAGS)' > "$$tmp"; \
	if ! cmp -s "$$tmp" "$@"; then \
		mv "$$tmp" "$@"; \
		rm -f $(HAL_BIN); \
	else \
		rm "$$tmp"; \
	fi

$(USB_PLAY_FLAGS_STAMP): FORCE
	@mkdir -p build
	@tmp="$@.tmp"; printf '%s\n' '$(HAL_CFLAGS)' > "$$tmp"; \
	if ! cmp -s "$$tmp" "$@"; then \
		mv "$$tmp" "$@"; \
		rm -f $(USB_PLAY); \
	else \
		rm "$$tmp"; \
	fi

ifeq ($(HAL_PREPARED_USB_SUBMIT_RUNTIME),1)
$(HAL_BIN): $(HAL_SRC) $(HAL_PLIST) $(HAL_FLAGS_STAMP)
	@mkdir -p $(HAL_BUNDLE)/Contents/MacOS $(HAL_PREPARED_OBJ_DIR)
	@install -m 644 $(HAL_PLIST) $(HAL_BUNDLE)/Contents/Info.plist
	xcrun clang $(HAL_CFLAGS) -c src/hal/OpenA8DJHAL.c -o $(HAL_PREPARED_OBJ_DIR)/OpenA8DJHAL.o
	xcrun clang $(HAL_CFLAGS) -c src/hal/OpenA8DJUSB.m -o $(HAL_PREPARED_OBJ_DIR)/OpenA8DJUSB.o
	xcrun clang++ $(HAL_CPP_CFLAGS) -c src/hal/OpenA8DJPreparedRuntimeBridge.mm -o $(HAL_PREPARED_OBJ_DIR)/OpenA8DJPreparedRuntimeBridge.o
	xcrun clang++ $(HAL_CPP_CFLAGS) -c core/src/usb_submit_plan.cpp -o $(HAL_PREPARED_OBJ_DIR)/usb_submit_plan.o
	xcrun clang++ $(HAL_CPP_CFLAGS) -c core/src/usb_request_pool.cpp -o $(HAL_PREPARED_OBJ_DIR)/usb_request_pool.o
	xcrun clang++ $(HAL_CPP_CFLAGS) -c core/src/prepared_usb_async_runtime.cpp -o $(HAL_PREPARED_OBJ_DIR)/prepared_usb_async_runtime.o
	xcrun clang++ -bundle $(HAL_FRAMEWORKS) -o $@ \
		$(HAL_PREPARED_OBJ_DIR)/OpenA8DJHAL.o \
		$(HAL_PREPARED_OBJ_DIR)/OpenA8DJUSB.o \
		$(HAL_PREPARED_OBJ_DIR)/OpenA8DJPreparedRuntimeBridge.o \
		$(HAL_PREPARED_OBJ_DIR)/usb_submit_plan.o \
		$(HAL_PREPARED_OBJ_DIR)/usb_request_pool.o \
		$(HAL_PREPARED_OBJ_DIR)/prepared_usb_async_runtime.o
else
$(HAL_BIN): $(HAL_SRC) $(HAL_PLIST) $(HAL_FLAGS_STAMP)
	@mkdir -p $(HAL_BUNDLE)/Contents/MacOS
	@install -m 644 $(HAL_PLIST) $(HAL_BUNDLE)/Contents/Info.plist
	$(HAL_LD) $(HAL_CFLAGS) -bundle $(HAL_FRAMEWORKS) -o $@ $(HAL_SRC)
endif

sign-hal: $(HAL_BIN)
	rm -rf "$(HAL_BUNDLE)/Contents/_CodeSignature"
	codesign --force --sign "$(SIGN_IDENTITY)" $(CODESIGN_TIMESTAMP) $(CODESIGN_OPTIONS) "$(HAL_BUNDLE)"
	if [ "$(HAL_STAPLE_AFTER_SIGN)" = "1" ]; then xcrun stapler staple "$(HAL_BUNDLE)"; xcrun stapler validate "$(HAL_BUNDLE)"; fi

sign-tools: $(CONTROL_TOOL) $(MIDI_BRIDGE)
	codesign --force --sign "$(SIGN_IDENTITY)" $(CODESIGN_TIMESTAMP) $(CODESIGN_OPTIONS) "$(CONTROL_TOOL)"
