all: $(TOOL) hal $(AUDIO_LIST) $(AUDIO_INSPECT) $(AUDIO_IO_TEST) $(AUDIO_WAV_PLAY) $(AUDIO_RECORD) $(AUDIO_CONFIG) $(AUDIO_DEFAULT) $(AUDIO_PAIR_TONE) $(AUDIO_ROUTE) $(INPUT_METER) $(MACBOOK_MIC_RECORD) $(USB_PLAY) $(USB_INPUT_METER) $(MIDI_BRIDGE) $(CONTROL_TOOL) $(MIDI_LIST)

$(TOOL): $(SRC)
	@mkdir -p build
	$(CC) $(CFLAGS) $(FRAMEWORKS) -o $@ $<

hal: $(HAL_BIN) $(CONTROL_TOOL)

hal-usb-clock-candidate:
	python3 scripts/build-hal-usb-clock-candidate \
		--candidate build/OpenA8DJ-usb-clock.driver \
		--json-out build/hal-candidates/usb-clock-candidate.json

hal-human-test-lite-candidate:
	python3 scripts/build-hal-human-test-lite-candidate \
		--candidate build/OpenA8DJ-human-test-lite.driver \
		--json-out build/hal-candidates/human-test-lite-candidate.json

hal-traktor-recovery-candidate:
	python3 scripts/build-hal-traktor-recovery-candidate \
		--candidate build/OpenA8DJ-traktor-recovery.driver \
		--json-out build/hal-candidates/traktor-recovery-candidate.json

hal-prepared-runtime:
	$(MAKE) -B hal \
		HAL_PREPARED_USB_SUBMIT_RUNTIME=1 \
		HAL_PREPARED_USB_SLOTS_PER_SUBMIT=8 \
		HAL_ISO_FRAMES=8 \
		HAL_CAPTURE_ISO_FRAMES=64 \
		HAL_PLAYBACK_ISO_FRAMES=8 \
		HAL_PLAYBACK_COALESCE_TRANSFERS=8 \
		HAL_CAPTURE_QUEUE=8 \
		HAL_PLAYBACK_QUEUE=8

hal-prepared-runtime-candidate:
	python3 scripts/build-hal-prepared-runtime-candidate \
		--candidate build/OpenA8DJ-prepared-runtime.driver \
		--json-out build/hal-candidates/prepared-runtime-candidate.json

hal-playback-scheduler-candidate:
	python3 scripts/build-hal-prepared-runtime-candidate \
		--candidate build/OpenA8DJ-playback-scheduler.driver \
		--json-out build/hal-candidates/playback-scheduler-candidate.json \
		--playback-only

hal-prepared-lite-candidate:
	python3 scripts/build-hal-prepared-runtime-candidate \
		--candidate build/OpenA8DJ-prepared-lite.driver \
		--json-out build/hal-candidates/prepared-lite-candidate.json \
		--slots-per-submit 2 \
		--capture-queue 4 \
