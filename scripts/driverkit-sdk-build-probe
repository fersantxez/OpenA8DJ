#!/usr/bin/env python3
import argparse
import json
import pathlib
import subprocess
import sys
from datetime import datetime, timezone


def run(argv):
    try:
        completed = subprocess.run(
            argv,
            check=False,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        return {
            "argv": argv,
            "return_code": completed.returncode,
            "output": completed.stdout.strip(),
        }
    except FileNotFoundError as exc:
        return {
            "argv": argv,
            "return_code": 127,
            "output": str(exc),
        }


def path_exists(value):
    return bool(value) and pathlib.Path(value).exists()


def write_json(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(
        description="Build-only DriverKit SDK probe. Never installs or activates a dext."
    )
    parser.add_argument("--source-root", required=True)
    parser.add_argument("--build-dir", required=True)
    parser.add_argument("--evidence", required=True)
    args = parser.parse_args()

    root = pathlib.Path(args.source_root).resolve()
    build_dir = pathlib.Path(args.build_dir).resolve()
    evidence_path = pathlib.Path(args.evidence).resolve()

    sdk_path = run(["xcrun", "--sdk", "driverkit", "--show-sdk-path"])
    sdk_version = run(["xcodebuild", "-version", "-sdk", "driverkit", "SDKVersion"])
    sdk_path_from_xcodebuild = run(["xcodebuild", "-version", "-sdk", "driverkit", "Path"])
    clang = run(["xcrun", "--sdk", "driverkit", "--find", "clang"])
    iig = run(["xcrun", "--sdk", "driverkit", "--find", "iig"])
    codesign = run(["xcrun", "--find", "codesign"])
    developer_dir = run(["xcode-select", "-p"])
    showsdks = run(["xcodebuild", "-showsdks"])

    tool_state = {
        "driverkit_sdk_path": sdk_path["output"],
        "driverkit_sdk_path_exists": path_exists(sdk_path["output"]),
        "driverkit_sdk_version": sdk_version["output"],
        "xcodebuild_driverkit_sdk_path": sdk_path_from_xcodebuild["output"],
        "xcodebuild_driverkit_sdk_path_exists": path_exists(sdk_path_from_xcodebuild["output"]),
        "driverkit_clang_path": clang["output"],
        "clang_available": path_exists(clang["output"]),
        "driverkit_iig_path": iig["output"],
        "iig_available": path_exists(iig["output"]),
        "codesign_path": codesign["output"],
        "codesign_available": path_exists(codesign["output"]),
        "developer_dir_effective": developer_dir["output"],
        "xcodebuild_driverkit_sdk_visible": "DriverKit" in showsdks["output"],
    }

    build_only_probe_allowed = all(
        [
            sdk_path["return_code"] == 0,
            tool_state["driverkit_sdk_path_exists"],
            sdk_version["return_code"] == 0,
            sdk_path_from_xcodebuild["return_code"] == 0,
            tool_state["xcodebuild_driverkit_sdk_path_exists"],
            clang["return_code"] == 0,
            tool_state["clang_available"],
            iig["return_code"] == 0,
            tool_state["iig_available"],
            codesign["return_code"] == 0,
            tool_state["codesign_available"],
            tool_state["xcodebuild_driverkit_sdk_visible"],
            "Xcode" in developer_dir["output"],
            ".app/Contents/Developer" in developer_dir["output"],
        ]
    )

    source_files = [
        root / "driverkit/extension/src/OpenA8DJAudioDriver.cpp",
        root / "driverkit/extension/src/OpenA8DJAudioDevice.cpp",
    ]
    compile_results = []
    blockers = []
    if not build_only_probe_allowed:
        blockers.append("real_driverkit_sdk_toolchain_missing_or_not_selected")
    else:
        build_dir.mkdir(parents=True, exist_ok=True)
        for source_file in source_files:
            command = [
                clang["output"],
                "-std=c++20",
                "-fsyntax-only",
                "-isysroot",
                sdk_path["output"],
                "-I",
                str(root / "driverkit/extension"),
                "-I",
                str(root / "driverkit/include"),
                "-I",
                str(root / "core/include"),
                str(source_file),
            ]
            result = run(command)
            compile_results.append(result)
            if result["return_code"] != 0:
                blockers.append(f"syntax_check_failed:{source_file.name}")

    passed = build_only_probe_allowed and not blockers
    payload = {
        "schema": "opena8djcpp.driverkit-sdk-build-probe.v1",
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "safety": "build_only_no_install_no_activation_no_audio_no_coreaudio_no_usb_no_hardware",
        "driver_installed_or_activated": False,
        "system_extension_activated": False,
        "hardware_touched": False,
        "coreaudio_touched": False,
        "usb_touched": False,
        "source_root": str(root),
        "build_dir": str(build_dir),
        "build_only_probe_allowed": build_only_probe_allowed,
        "tool_state": tool_state,
        "tool_commands": {
            "sdk_path": sdk_path,
            "sdk_version": sdk_version,
            "sdk_path_from_xcodebuild": sdk_path_from_xcodebuild,
            "clang": clang,
            "iig": iig,
            "codesign": codesign,
            "developer_dir": developer_dir,
            "showsdks": showsdks,
        },
        "source_files": [str(path) for path in source_files],
        "compile_results": compile_results,
        "blockers": blockers,
        "result": "PASS" if passed else ("BLOCKED" if not build_only_probe_allowed else "FAIL"),
        "blocked_claim": (
            ""
            if passed
            else "NO_REAL_DRIVERKIT_DEXT_BUILD_OR_READINESS_CLAIM_WITHOUT_BUILD_ONLY_SDK_PROBE_PASS"
        ),
    }
    write_json(evidence_path, payload)
    print(json.dumps(payload, indent=2, sort_keys=True))
    if passed:
        return 0
    if not build_only_probe_allowed:
        return 2
    return 1


if __name__ == "__main__":
    sys.exit(main())
