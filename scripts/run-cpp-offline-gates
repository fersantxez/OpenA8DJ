./build/cpp-release/opena8djcpp_capture_matrix_quality_analysis | tee "$EVIDENCE_DIR/capture-matrix-quality-analysis.json"
./build/cpp-release/opena8djcpp_soundcheck_wav_quality --health-check | tee "$EVIDENCE_DIR/soundcheck-wav-quality.json"
./build/cpp-release/opena8djcpp_channel_leakage_tone_contract | tee "$EVIDENCE_DIR/channel-leakage-tone-contract.json"
