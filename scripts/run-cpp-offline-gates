prepared_transport_routing_timecode = load_json("prepared-transport-routing-timecode-contract.json")
prepared_transport_recovery = load_json("prepared-transport-recovery-contract.json")
prepared_slot_scheduler = load_json("prepared-slot-scheduler-contract.json")
prepared_transport_pressure = load_json("prepared-transport-pressure-gate.json")
prepared_transport_migration = load_json("prepared-transport-migration-gate.json")
static = load_json("static-policy.json")
hardware_lock_policy = load_json("hardware-lock-policy.json")
stream_stats_contract = load_json("stream-stats-contract.json")
bench = load_json("offline-bench-release.json")
promotion_evaluator = load_json("promotion-readiness-offline-check.json")

summary = {
