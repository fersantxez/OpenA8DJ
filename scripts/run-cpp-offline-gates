  exit "$WATCH_KNOWN_GOOD_ROUTE_RC"
fi
printf '%s\n' "$WATCH_KNOWN_GOOD_ROUTE_RC" > "$EVIDENCE_DIR/watch-known-good-route.rc"
python3 scripts/plan-physical-evidence-window \
  --watcher-json "$EVIDENCE_DIR/watch-known-good-route.json" \
  --json-out "$EVIDENCE_DIR/physical-evidence-window-plan.json" \
  >/dev/null
python3 scripts/plan-timecode-physical-window \
  --json-out "$EVIDENCE_DIR/timecode-physical-window-plan.json" \
  >/dev/null
./build/cpp-release/opena8djcpp_capture_readiness_contract | tee "$EVIDENCE_DIR/capture-readiness-contract.json"
./build/cpp-release/opena8djcpp_physical_route_matrix_contract | tee "$EVIDENCE_DIR/physical-route-matrix-contract.json"
python3 scripts/check-stream-stats-contract.py | tee "$EVIDENCE_DIR/stream-stats-contract.json"
python3 -m py_compile \
  scripts/check-hal-bundle-complete \
  scripts/build-hal-prepared-runtime-candidate \
  scripts/build-hal-hotpath-diagnostic-candidate \
  scripts/physical-window-preflight \
  scripts/analyze-soundcheck-window-trace.py \
  scripts/analyze-timebase-family.py \
  scripts/evaluate-promotion-readiness.py \
  scripts/test-promotion-window-contract.py \
  scripts/test-known-good-route-selector.py \
  scripts/test-watch-known-good-route.py \
  scripts/test-plan-physical-evidence-window.py \
  scripts/validate-known-good-route-request.py \
  scripts/known-good-route-selector \
  scripts/watch-known-good-route \
  scripts/plan-physical-evidence-window \
  scripts/plan-timecode-physical-window \
  scripts/test-plan-timecode-physical-window.py \
  scripts/analyze-route-contamination.py \
  scripts/test-route-contamination-analysis.py \
  scripts/evaluate-final-objective-readiness.py \
  scripts/test-final-objective-readiness.py \
  scripts/build-human-test-rc-packet.py \
  scripts/test-build-human-test-rc-packet.py \
  scripts/audit-objective-external-readiness.py \
  scripts/test-audit-objective-external-readiness.py \
  scripts/human-test-rc-status \
  scripts/summarize-transport-cadence.py \
  scripts/summarize-physical-product-evidence.py \
  scripts/analyze-audiophile-wav.py
python3 scripts/test-promotion-window-contract.py | tee "$EVIDENCE_DIR/promotion-window-contract.txt"
python3 scripts/test-known-good-route-selector.py | tee "$EVIDENCE_DIR/known-good-route-selector-test.txt"
python3 scripts/test-watch-known-good-route.py | tee "$EVIDENCE_DIR/watch-known-good-route-test.txt"
python3 scripts/test-plan-physical-evidence-window.py | tee "$EVIDENCE_DIR/physical-evidence-window-plan-test.txt"
python3 scripts/test-plan-timecode-physical-window.py | tee "$EVIDENCE_DIR/timecode-physical-window-plan-test.txt"
python3 scripts/test-route-contamination-analysis.py | tee "$EVIDENCE_DIR/route-contamination-analysis-test.txt"
python3 scripts/test-final-objective-readiness.py | tee "$EVIDENCE_DIR/final-objective-readiness-test.txt"
python3 scripts/test-build-human-test-rc-packet.py | tee "$EVIDENCE_DIR/human-test-rc-packet-test.txt"
python3 scripts/test-audit-objective-external-readiness.py | tee "$EVIDENCE_DIR/objective-external-readiness-test.txt"
set +e
python3 scripts/evaluate-promotion-readiness.py \
  --json-out "$EVIDENCE_DIR/promotion-readiness-offline-check.json" \
