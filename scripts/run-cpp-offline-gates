  | tee "$EVIDENCE_DIR/runtime-discontinuity-parity-gate.json"
./build/cpp-release/opena8djcpp_physical_run_compare | tee "$EVIDENCE_DIR/physical-run-product-superiority.json"
./build/cpp-release/opena8djcpp_physical_evidence_frontier | tee "$EVIDENCE_DIR/physical-evidence-frontier.json"
./build/cpp-release/opena8djcpp_physical_capture_forensics | tee "$EVIDENCE_DIR/physical-capture-forensics.json"
./build/cpp-release/opena8djcpp_direct_usb_path_attribution | tee "$EVIDENCE_DIR/direct-usb-path-attribution.json"
./build/cpp-release/opena8djcpp_capture_route_health_gate | tee "$EVIDENCE_DIR/capture-route-health-gate.json"
