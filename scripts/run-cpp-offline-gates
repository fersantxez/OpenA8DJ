  --candidate build/OpenA8DJ.driver \
  --json-out "$EVIDENCE_DIR/hal-bundle-complete.json" >/dev/null
./build/cpp-release/opena8djcpp_hal_candidate_safety_gate | tee "$EVIDENCE_DIR/hal-candidate-safety-gate.json"
./build/cpp-release/opena8djcpp_static_policy_check | tee "$EVIDENCE_DIR/static-policy.json"
./build/cpp-release/opena8djcpp_hardware_lock_policy_check | tee "$EVIDENCE_DIR/hardware-lock-policy.json"
python3 scripts/physical-route-inventory --json-out "$EVIDENCE_DIR/physical-route-inventory.json" >/dev/null
python3 scripts/known-good-route-selector --json-out "$EVIDENCE_DIR/known-good-route-selector.json" >/dev/null
set +e
python3 scripts/watch-known-good-route \
  --timeout-seconds 0 \
  --json-out "$EVIDENCE_DIR/watch-known-good-route.json" \
  >/dev/null
WATCH_KNOWN_GOOD_ROUTE_RC=$?
set -e
