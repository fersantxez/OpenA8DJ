#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EVIDENCE_DIR="$ROOT/local-analysis/cpp-offline"
mkdir -p "$EVIDENCE_DIR"

cd "$ROOT"

cmake -S . -B build/cpp-offline
cmake --build build/cpp-offline
ctest --test-dir build/cpp-offline --output-on-failure | tee "$EVIDENCE_DIR/ctest-default.txt"

cmake -S . -B build/cpp-release -DCMAKE_BUILD_TYPE=Release
cmake --build build/cpp-release
ctest --test-dir build/cpp-release --output-on-failure | tee "$EVIDENCE_DIR/ctest-release.txt"
./build/cpp-release/opena8djcpp_packet_matrix | tee "$EVIDENCE_DIR/packet-matrix.json"
./build/cpp-release/opena8djcpp_protocol_contract | tee "$EVIDENCE_DIR/protocol-contract.json"
./build/cpp-release/opena8djcpp_simulated_output_matrix | tee "$EVIDENCE_DIR/simulated-output-matrix.json"
python3 scripts/validate-mode2-output-packing.py \
  --start-byte all \
  --frames 96 \
  --transfer-bytes 352 \
  --byte-order big \
  --gain 1.0 \
  | tee "$EVIDENCE_DIR/mode2-python-oracle.txt"
python3 scripts/mode2-cross-oracle-parity \
  --binary ./build/cpp-release/opena8djcpp_mode2_cpp_oracle_dump \
  --frames 96 \
  | tee "$EVIDENCE_DIR/mode2-cross-oracle-parity.json"
./build/cpp-release/opena8djcpp_timecode_matrix | tee "$EVIDENCE_DIR/timecode-matrix.json"
./build/cpp-release/opena8djcpp_timecode_signal_analysis | tee "$EVIDENCE_DIR/timecode-signal-analysis.json"
./build/cpp-release/opena8djcpp_dvs_signal_smoke | tee "$EVIDENCE_DIR/dvs-signal-smoke.json"
./build/cpp-release/opena8djcpp_dvs_packet_input_decode | tee "$EVIDENCE_DIR/dvs-packet-input-decode.json"
./build/cpp-release/opena8djcpp_timecode_readiness_gate | tee "$EVIDENCE_DIR/timecode-readiness-gate.json"
./build/cpp-release/opena8djcpp_realtime_audit | tee "$EVIDENCE_DIR/realtime-audit.json"
./build/cpp-release/opena8djcpp_driverkit_surface_model | tee "$EVIDENCE_DIR/driverkit-surface-model.json"
./build/cpp-release/opena8djcpp_driverkit_shell_contract | tee "$EVIDENCE_DIR/driverkit-shell-contract.json"
./build/cpp-release/opena8djcpp_driverkit_runtime_contract | tee "$EVIDENCE_DIR/driverkit-runtime-contract.json"
./build/cpp-release/opena8djcpp_driverkit_extension_scaffold_contract | tee "$EVIDENCE_DIR/driverkit-extension-scaffold-contract.json"
./build/cpp-release/opena8djcpp_driverkit_prepared_transport_contract | tee "$EVIDENCE_DIR/driverkit-prepared-transport-contract.json"
./build/cpp-release/opena8djcpp_driverkit_prepared_hotpath_contract | tee "$EVIDENCE_DIR/driverkit-prepared-hotpath-contract.json"
./build/cpp-release/opena8djcpp_prepared_transport_packet_contract | tee "$EVIDENCE_DIR/prepared-transport-packet-contract.json"
./build/cpp-release/opena8djcpp_prepared_transport_routing_timecode_contract | tee "$EVIDENCE_DIR/prepared-transport-routing-timecode-contract.json"
./build/cpp-release/opena8djcpp_prepared_transport_recovery_contract | tee "$EVIDENCE_DIR/prepared-transport-recovery-contract.json"
./build/cpp-release/opena8djcpp_prepared_slot_scheduler_contract | tee "$EVIDENCE_DIR/prepared-slot-scheduler-contract.json"
./build/cpp-release/opena8djcpp_prepared_transport_pressure_gate | tee "$EVIDENCE_DIR/prepared-transport-pressure-gate.json"
./build/cpp-release/opena8djcpp_jitter_model | tee "$EVIDENCE_DIR/jitter-model.json"
./build/cpp-release/opena8djcpp_transfer_pool_model | tee "$EVIDENCE_DIR/transfer-pool-model.json"
./build/cpp-release/opena8djcpp_transport_budget_model | tee "$EVIDENCE_DIR/transport-budget-model.json"
./build/cpp-release/opena8djcpp_hot_path_timing_analysis | tee "$EVIDENCE_DIR/hot-path-timing-analysis.json"
./build/cpp-release/opena8djcpp_quality_root_cause_analysis | tee "$EVIDENCE_DIR/quality-root-cause-analysis.json"
./build/cpp-release/opena8djcpp_loopback_quality_analysis | tee "$EVIDENCE_DIR/loopback-quality-analysis.json"
./build/cpp-release/opena8djcpp_capture_matrix_quality_analysis | tee "$EVIDENCE_DIR/capture-matrix-quality-analysis.json"
./build/cpp-release/opena8djcpp_capture_route_health_gate | tee "$EVIDENCE_DIR/capture-route-health-gate.json"
./build/cpp-release/opena8djcpp_soundcheck_wav_quality | tee "$EVIDENCE_DIR/soundcheck-wav-quality.json"
./build/cpp-release/opena8djcpp_channel_leakage_tone_contract | tee "$EVIDENCE_DIR/channel-leakage-tone-contract.json"
./build/cpp-release/opena8djcpp_physical_run_compare | tee "$EVIDENCE_DIR/physical-run-product-superiority.json"
./build/cpp-release/opena8djcpp_physical_evidence_frontier | tee "$EVIDENCE_DIR/physical-evidence-frontier.json"
./build/cpp-release/opena8djcpp_physical_capture_forensics | tee "$EVIDENCE_DIR/physical-capture-forensics.json"
./build/cpp-release/opena8djcpp_direct_usb_path_attribution | tee "$EVIDENCE_DIR/direct-usb-path-attribution.json"
./build/cpp-release/opena8djcpp_static_policy_check | tee "$EVIDENCE_DIR/static-policy.json"
./build/cpp-release/opena8djcpp_hardware_lock_policy_check | tee "$EVIDENCE_DIR/hardware-lock-policy.json"
python3 scripts/check-stream-stats-contract.py | tee "$EVIDENCE_DIR/stream-stats-contract.json"
python3 -m py_compile \
  scripts/analyze-soundcheck-window-trace.py \
  scripts/analyze-timebase-family.py \
  scripts/evaluate-promotion-readiness.py \
  scripts/summarize-transport-cadence.py \
  scripts/summarize-physical-product-evidence.py
set +e
python3 scripts/evaluate-promotion-readiness.py \
  --json-out "$EVIDENCE_DIR/promotion-readiness-offline-check.json" \
  > "$EVIDENCE_DIR/promotion-readiness-offline-check.stdout"
PROMOTION_EVALUATOR_RC=$?
set -e
if [[ "$PROMOTION_EVALUATOR_RC" -ne 0 && "$PROMOTION_EVALUATOR_RC" -ne 1 ]]; then
  exit "$PROMOTION_EVALUATOR_RC"
fi
./build/cpp-release/opena8djcpp_prepared_transport_migration_gate | tee "$EVIDENCE_DIR/prepared-transport-migration-gate.json"
./build/cpp-release/opena8djcpp_offline_bench | tee "$EVIDENCE_DIR/offline-bench-release.json"
python3 - <<'PY'
import json
import re
import subprocess
from pathlib import Path

root = Path.cwd()
evidence = root / "local-analysis/cpp-offline"


def load_json(name):
    with open(evidence / name, "r", encoding="utf-8") as handle:
        return json.load(handle)


def ctest_summary(name):
    text = (evidence / name).read_text(encoding="utf-8", errors="replace")
    match = re.search(r"100% tests passed, 0 tests failed out of (\d+)", text)
    return {
        "status": "PASS" if match else "FAIL",
        "tests_passed": int(match.group(1)) if match else 0,
        "tests_failed": 0 if match else 1,
        "evidence": f"local-analysis/cpp-offline/{name}",
    }


def git_text(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


packet = load_json("packet-matrix.json")
mode2_cross_oracle = load_json("mode2-cross-oracle-parity.json")
protocol = load_json("protocol-contract.json")
simulated_output = load_json("simulated-output-matrix.json")
timecode = load_json("timecode-matrix.json")
timecode_signal = load_json("timecode-signal-analysis.json")
dvs = load_json("dvs-signal-smoke.json")
dvs_packet = load_json("dvs-packet-input-decode.json")
timecode_readiness = load_json("timecode-readiness-gate.json")
jitter = load_json("jitter-model.json")
transfer_pool = load_json("transfer-pool-model.json")
transport_budget = load_json("transport-budget-model.json")
hot_path_timing = load_json("hot-path-timing-analysis.json")
quality_root_cause = load_json("quality-root-cause-analysis.json")
loopback_quality = load_json("loopback-quality-analysis.json")
capture_matrix_quality = load_json("capture-matrix-quality-analysis.json")
capture_route_health = load_json("capture-route-health-gate.json")
soundcheck_wav_quality = load_json("soundcheck-wav-quality.json")
channel_leakage_tone = load_json("channel-leakage-tone-contract.json")
physical_run_product_superiority = load_json("physical-run-product-superiority.json")
