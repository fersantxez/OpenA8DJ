  exit "$PROMOTION_EVALUATOR_RC"
fi
python3 scripts/evaluate-final-objective-readiness.py \
  --json-out "$EVIDENCE_DIR/final-objective-readiness.json" \
  >/dev/null
./build/cpp-release/opena8djcpp_prepared_transport_migration_gate | tee "$EVIDENCE_DIR/prepared-transport-migration-gate.json"
./build/cpp-release/opena8djcpp_physical_window_readiness_gate | tee "$EVIDENCE_DIR/physical-window-readiness-gate.json"
./build/cpp-release/opena8djcpp_evidence_json_contract | tee "$EVIDENCE_DIR/evidence-json-contract.json"
./build/cpp-release/opena8djcpp_diagnostic_pass_semantics_gate | tee "$EVIDENCE_DIR/diagnostic-pass-semantics-gate.json"
./build/cpp-release/opena8djcpp_product_quality_claim_gate | tee "$EVIDENCE_DIR/product-quality-claim-gate.json"
./build/cpp-release/opena8djcpp_hal_transport_runtime_gate | tee "$EVIDENCE_DIR/hal-transport-runtime-gate.json"
./build/cpp-release/opena8djcpp_hal_logical_capture_batching_contract | tee "$EVIDENCE_DIR/hal-logical-capture-batching-contract.json"
./build/cpp-release/opena8djcpp_hal_input_spsc_ring_contract | tee "$EVIDENCE_DIR/hal-input-spsc-ring-contract.json"
./build/cpp-release/opena8djcpp_hal_runtime_geometry_observability_contract | tee "$EVIDENCE_DIR/hal-runtime-geometry-observability-contract.json"
./build/cpp-release/opena8djcpp_physical_submit_comparison_contract | tee "$EVIDENCE_DIR/physical-submit-comparison-contract.json"
./build/cpp-release/opena8djcpp_prepared_runtime_physical_window_contract | tee "$EVIDENCE_DIR/prepared-runtime-physical-window-contract.json"
./build/cpp-release/opena8djcpp_human_test_rc_gate | tee "$EVIDENCE_DIR/human-test-rc-gate.json"
python3 scripts/human-test-rc-status > "$EVIDENCE_DIR/human-test-rc-status.json"
./build/cpp-release/opena8djcpp_offline_bench | tee "$EVIDENCE_DIR/offline-bench-release.json"
python3 - <<'PY'
import json
import re
import subprocess
from pathlib import Path

root = Path.cwd()
evidence = root / "local-analysis/cpp-offline"


def load_json(name):
    with open(evidence / name, "r", encoding="utf-8") as handle:
        return json.load(handle)


def ctest_summary(name):
    text = (evidence / name).read_text(encoding="utf-8", errors="replace")
    match = re.search(r"100% tests passed, 0 tests failed out of (\d+)", text)
    return {
        "status": "PASS" if match else "FAIL",
        "tests_passed": int(match.group(1)) if match else 0,
        "tests_failed": 0 if match else 1,
        "evidence": f"local-analysis/cpp-offline/{name}",
    }


def degraded_self_test_summary(payload, evidence_name):
    blockers = payload.get("blockers") or []
    rejected = payload.get("result") == "FAIL" and bool(blockers)
    return {
        "status": "PASS" if rejected else "FAIL",
        "meaning": "PASS means this deliberately degraded capture was rejected",
        "analyzer_result": payload.get("result"),
        "schema": payload.get("schema"),
        "alignment_score": payload.get("alignment", {}).get("score"),
        "left_snr_db": payload.get("left", {}).get("snr_db"),
        "right_snr_db": payload.get("right", {}).get("snr_db"),
        "blockers": blockers,
        "product_claim_allowed": payload.get("product_claim_allowed"),
        "evidence": f"local-analysis/cpp-offline/{evidence_name}",
    }


def git_text(*args):
    return subprocess.check_output(["git", *args], text=True).strip()


def git_worktree_dirty():
    return bool(subprocess.check_output(["git", "status", "--porcelain"], text=True).strip())


