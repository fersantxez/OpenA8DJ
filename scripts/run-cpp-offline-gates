#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
EVIDENCE_DIR="$ROOT/local-analysis/cpp-offline"
mkdir -p "$EVIDENCE_DIR"

cd "$ROOT"

cmake -S . -B build/cpp-offline
cmake --build build/cpp-offline
make -C "$ROOT" hal >/dev/null
python3 scripts/check-hal-bundle-complete \
  --candidate build/OpenA8DJ.driver \
  --json-out "$EVIDENCE_DIR/hal-bundle-complete.json"
python3 scripts/build-hal-prepared-runtime-candidate \
  --candidate build/OpenA8DJ-prepared-runtime.driver \
  --json-out "$EVIDENCE_DIR/hal-prepared-runtime-candidate.json"
python3 scripts/check-hal-bundle-complete \
  --candidate build/OpenA8DJ-prepared-runtime.driver \
  --json-out "$EVIDENCE_DIR/hal-prepared-runtime-bundle-complete.json"
python3 scripts/build-hal-prepared-runtime-candidate \
  --candidate build/OpenA8DJ-playback-scheduler.driver \
  --json-out "$EVIDENCE_DIR/hal-playback-scheduler-candidate.json" \
  --playback-only
python3 scripts/check-hal-bundle-complete \
  --candidate build/OpenA8DJ-playback-scheduler.driver \
  --json-out "$EVIDENCE_DIR/hal-playback-scheduler-bundle-complete.json"
python3 scripts/build-hal-hotpath-diagnostic-candidate \
  --candidate build/OpenA8DJ-hotpath-diagnostic.driver \
  --json-out "$EVIDENCE_DIR/hal-hotpath-diagnostic-candidate.json" \
  >/dev/null
python3 scripts/check-hal-bundle-complete \
  --candidate build/OpenA8DJ-hotpath-diagnostic.driver \
  --json-out "$EVIDENCE_DIR/hal-hotpath-diagnostic-bundle-complete.json"
./build/cpp-offline/opena8djcpp_usb_submit_plan_contract > "$EVIDENCE_DIR/usb-submit-plan-contract.json"
./build/cpp-offline/opena8djcpp_usb_submit_payload_contract > "$EVIDENCE_DIR/usb-submit-payload-contract.json"
./build/cpp-offline/opena8djcpp_prepared_usb_runtime_submit_contract > "$EVIDENCE_DIR/prepared-usb-runtime-submit-contract.json"
./build/cpp-offline/opena8djcpp_prepared_usb_async_runtime_contract > "$EVIDENCE_DIR/prepared-usb-async-runtime-contract.json"
./build/cpp-offline/opena8djcpp_hal_prepared_submit_adapter_contract > "$EVIDENCE_DIR/hal-prepared-submit-adapter-contract.json"
./build/cpp-offline/opena8djcpp_hal_prepared_runtime_source_contract > "$EVIDENCE_DIR/hal-prepared-runtime-source-contract.json"
./build/cpp-offline/opena8djcpp_hal_prepared_runtime_binding_contract > "$EVIDENCE_DIR/hal-prepared-runtime-binding-contract.json"
./build/cpp-offline/opena8djcpp_driverkit_usb_submit_binding_contract > "$EVIDENCE_DIR/driverkit-usb-submit-binding-contract.json"
./build/cpp-offline/opena8djcpp_driverkit_usb_request_lifecycle_contract > "$EVIDENCE_DIR/driverkit-usb-request-lifecycle-contract.json"
./build/cpp-offline/opena8djcpp_driverkit_usb_request_shutdown_contract > "$EVIDENCE_DIR/driverkit-usb-request-shutdown-contract.json"
./build/cpp-offline/opena8djcpp_driverkit_usb_isochronous_schedule_contract > "$EVIDENCE_DIR/driverkit-usb-isochronous-schedule-contract.json"
ctest --test-dir build/cpp-offline -E opena8djcpp_evidence_schema_check --output-on-failure | tee "$EVIDENCE_DIR/ctest-default.txt"

cmake -S . -B build/cpp-release -DCMAKE_BUILD_TYPE=Release
cmake --build build/cpp-release
ctest --test-dir build/cpp-release -E opena8djcpp_evidence_schema_check --output-on-failure | tee "$EVIDENCE_DIR/ctest-release.txt"
./build/cpp-release/opena8djcpp_packet_matrix | tee "$EVIDENCE_DIR/packet-matrix.json"
./build/cpp-release/opena8djcpp_protocol_contract | tee "$EVIDENCE_DIR/protocol-contract.json"
./build/cpp-release/opena8djcpp_simulated_output_matrix | tee "$EVIDENCE_DIR/simulated-output-matrix.json"
python3 scripts/validate-mode2-output-packing.py \
  --start-byte all \
  --frames 96 \
  --transfer-bytes 352 \
  --byte-order big \
  --gain 1.0 \
  | tee "$EVIDENCE_DIR/mode2-python-oracle.txt"
python3 scripts/mode2-cross-oracle-parity \
  --binary ./build/cpp-release/opena8djcpp_mode2_cpp_oracle_dump \
  --frames 96 \
  | tee "$EVIDENCE_DIR/mode2-cross-oracle-parity.json"
./build/cpp-release/opena8djcpp_timecode_matrix | tee "$EVIDENCE_DIR/timecode-matrix.json"
./build/cpp-release/opena8djcpp_timecode_signal_analysis | tee "$EVIDENCE_DIR/timecode-signal-analysis.json"
./build/cpp-release/opena8djcpp_dvs_signal_smoke | tee "$EVIDENCE_DIR/dvs-signal-smoke.json"
./build/cpp-release/opena8djcpp_dvs_packet_input_decode | tee "$EVIDENCE_DIR/dvs-packet-input-decode.json"
./build/cpp-release/opena8djcpp_dvs_timecode_stress_margin | tee "$EVIDENCE_DIR/dvs-timecode-stress-margin.json"
./build/cpp-release/opena8djcpp_timecode_readiness_gate | tee "$EVIDENCE_DIR/timecode-readiness-gate.json"
./build/cpp-release/opena8djcpp_realtime_audit | tee "$EVIDENCE_DIR/realtime-audit.json"
./build/cpp-release/opena8djcpp_driverkit_surface_model | tee "$EVIDENCE_DIR/driverkit-surface-model.json"
./build/cpp-release/opena8djcpp_driverkit_shell_contract | tee "$EVIDENCE_DIR/driverkit-shell-contract.json"
./build/cpp-release/opena8djcpp_driverkit_runtime_contract | tee "$EVIDENCE_DIR/driverkit-runtime-contract.json"
./build/cpp-release/opena8djcpp_driverkit_extension_scaffold_contract | tee "$EVIDENCE_DIR/driverkit-extension-scaffold-contract.json"
./build/cpp-release/opena8djcpp_driverkit_runtime_binding_gap_gate | tee "$EVIDENCE_DIR/driverkit-runtime-binding-gap-gate.json"
./build/cpp-release/opena8djcpp_driverkit_device_binding_contract | tee "$EVIDENCE_DIR/driverkit-device-binding-contract.json"
./build/cpp-release/opena8djcpp_driverkit_sdk_preflight_gate | tee "$EVIDENCE_DIR/driverkit-sdk-preflight-gate.json"
./build/cpp-release/opena8djcpp_driverkit_prepared_transport_contract | tee "$EVIDENCE_DIR/driverkit-prepared-transport-contract.json"
./build/cpp-release/opena8djcpp_driverkit_prepared_hotpath_contract | tee "$EVIDENCE_DIR/driverkit-prepared-hotpath-contract.json"
./build/cpp-release/opena8djcpp_driverkit_usb_submit_binding_contract | tee "$EVIDENCE_DIR/driverkit-usb-submit-binding-contract.json"
./build/cpp-release/opena8djcpp_driverkit_usb_request_lifecycle_contract | tee "$EVIDENCE_DIR/driverkit-usb-request-lifecycle-contract.json"
./build/cpp-release/opena8djcpp_driverkit_usb_request_shutdown_contract | tee "$EVIDENCE_DIR/driverkit-usb-request-shutdown-contract.json"
