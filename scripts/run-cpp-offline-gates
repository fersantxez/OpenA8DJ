./build/cpp-release/opena8djcpp_prepared_usb_runtime_submit_contract | tee "$EVIDENCE_DIR/prepared-usb-runtime-submit-contract.json"
./build/cpp-release/opena8djcpp_prepared_usb_async_runtime_contract | tee "$EVIDENCE_DIR/prepared-usb-async-runtime-contract.json"
./build/cpp-release/opena8djcpp_hal_prepared_submit_adapter_contract | tee "$EVIDENCE_DIR/hal-prepared-submit-adapter-contract.json"
./build/cpp-release/opena8djcpp_hal_prepared_runtime_source_contract | tee "$EVIDENCE_DIR/hal-prepared-runtime-source-contract.json"
./build/cpp-release/opena8djcpp_hal_prepared_runtime_binding_contract | tee "$EVIDENCE_DIR/hal-prepared-runtime-binding-contract.json"
