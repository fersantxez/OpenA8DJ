#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOP_BIN="${OPENA8DJ_GUARD_TOP_BIN:-top}"
PGREP_BIN="${OPENA8DJ_GUARD_PGREP_BIN:-pgrep}"
HEALTH_BIN="${OPENA8DJ_AUDIO_HEALTH_BIN:-$ROOT/scripts/audio-stack-health}"
AUDIO_LIST_BIN="${OPENA8DJ_AUDIO_LIST_BIN:-$ROOT/build/audio-list}"
threshold="25"
total_threshold="120"
wait_seconds="0"
enumeration_timeout="5"
min_idle_pct="20"
recover="0"
unload_opena8dj="0"
force_unload_opena8dj="0"
close_media_apps="1"
run_dir=""

usage() {
  cat <<USAGE
usage: scripts/audio-stack-guard [options]

Checks that the macOS audio stack is safe before OpenA8DJ testing. It combines
CPU health, Core Audio enumeration with a timeout, and optional emergency
recovery.

Options:
  --threshold PCT             Fail if one watched process group exceeds this CPU pct (default: 25)
  --total-threshold PCT       Fail if watched process groups exceed this total CPU pct (default: 120)
  --wait SECONDS              Wait before sampling
  --enumeration-timeout SEC   Fail if build/audio-list hangs longer than this (default: 5)
  --min-idle-pct PCT          Fail if instant system idle CPU is below this (default: 20)
  --run-dir DIR               Directory for logs (default: local-analysis/audio-stack-guard/<timestamp>)
  --recover                   Try to recover if checks fail
  --unload-opena8dj           During recovery, move active OpenA8DJ HAL out of the active HAL directory
  --force-unload-opena8dj     Move active OpenA8DJ HAL out before the final health evaluation
  --keep-media-apps           Do not close VLC/Spotify/Traktor/NIHardwareAgent during recovery
  -h, --help                  Show this help
USAGE
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --threshold)
      threshold="$2"; shift 2 ;;
    --total-threshold)
      total_threshold="$2"; shift 2 ;;
    --wait)
      wait_seconds="$2"; shift 2 ;;
    --enumeration-timeout)
      enumeration_timeout="$2"; shift 2 ;;
    --min-idle-pct)
      min_idle_pct="$2"; shift 2 ;;
    --run-dir)
      run_dir="$2"; shift 2 ;;
    --recover)
      recover="1"; shift ;;
    --unload-opena8dj)
      unload_opena8dj="1"; shift ;;
    --force-unload-opena8dj)
      force_unload_opena8dj="1"; shift ;;
    --keep-media-apps)
      close_media_apps="0"; shift ;;
    -h|--help)
      usage; exit 0 ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2 ;;
  esac
done

# This command is deliberately observational. Mutating recovery is handled by
# the transaction manager, which can journal and verify rollback.
if [ "$recover" = "1" ] || [ "$unload_opena8dj" = "1" ] || [ "$force_unload_opena8dj" = "1" ]; then
  echo "audio_stack_guard=INFRA_ERROR"
  echo "error=mutating_recovery_requires_transaction_manager"
  exit 2
fi

if [ -z "$run_dir" ]; then
  run_dir="$ROOT/local-analysis/audio-stack-guard/guard-$(date +%Y%m%d-%H%M%S)"
fi
mkdir -p "$run_dir"

active_hal="/Library/Audio/Plug-Ins/HAL/OpenA8DJ.driver"

log_step() {
  printf '%s\n' "$*"
}

hal_state() {
  if [ -d "$active_hal" ]; then
    echo "loaded"
  else
    echo "unloaded"
  fi
}

run_with_timeout() {
  local timeout="$1"
  local stdout_path="$2"
  local stderr_path="$3"
  shift 3
  /usr/bin/python3 "$ROOT/scripts/run-child-with-timeout.py" \
    "$timeout" "$stdout_path" "$stderr_path" "$@"
}

top_snapshot() {
  local rc=0
  run_with_timeout 5 "$1.raw" "$1.err" \
    "$TOP_BIN" -l 2 -s 1 -n 30 -o cpu -stats pid,cpu,state,command || rc=$?
  if [ "$rc" != "0" ]; then
    return "$rc"
  fi
  awk 'BEGIN{s=0} /^Processes:/{s++} s==2{print}' "$1.raw" > "$1"
}

top_idle_pct() {
  awk '
    /CPU usage:/ {
      for (i = 1; i <= NF; i++) {
        if ($i == "idle") {
          value = $(i - 1)
          gsub("%", "", value)
          print value
          exit
        }
      }
    }
  ' "$1"
}

health_check() {
  local rc=0
  local health_timeout="${OPENA8DJ_GUARD_HEALTH_TIMEOUT:-60}"
  run_with_timeout "$health_timeout" \
    "$run_dir/audio-stack-health.txt" \
    "$run_dir/audio-stack-health.err" \
    "$HEALTH_BIN" \
    --threshold "$threshold" \
    --total-threshold "$total_threshold" \
    --wait "$wait_seconds" \
    --windows 3 \
    --window-seconds 10 \
    --sample-interval 1 \
    --min-idle-pct "$min_idle_pct" \
    --audio-list-bin "$AUDIO_LIST_BIN" \
    --enumeration-timeout "$enumeration_timeout" \
    --evidence-dir "$run_dir/health-windows" || rc=$?
  if [ "$rc" -eq 0 ]; then
    printf '{"status":"PASS","exit_code":0,"signal":null,"timed_out":false}\n' > "$run_dir/audio-stack-health-status.json"
  elif [ "$rc" -eq 124 ]; then
    printf 'audio_stack_health=HUNG\n' >> "$run_dir/audio-stack-health.txt"
    printf '{"status":"HUNG","exit_code":124,"signal":null,"timed_out":true}\n' > "$run_dir/audio-stack-health-status.json"
  elif [ "$rc" -ge 128 ]; then
    local signal_number=$((rc - 128))
    printf '{"status":"SIGNALED","exit_code":null,"signal":%s,"timed_out":false}\n' "$signal_number" > "$run_dir/audio-stack-health-status.json"
  elif [ "$rc" -eq 1 ]; then
    printf '{"status":"FAIL","exit_code":1,"signal":null,"timed_out":false}\n' > "$run_dir/audio-stack-health-status.json"
  else
    printf '{"status":"INFRA_ERROR","exit_code":%s,"signal":null,"timed_out":false}\n' "$rc" > "$run_dir/audio-stack-health-status.json"
  fi
  return "$rc"
}

enumeration_check() {
  if [ ! -x "$AUDIO_LIST_BIN" ]; then
    printf 'core_audio_enumeration=INFRA_ERROR\nreason=missing_or_non_executable_audio_list\n' > "$run_dir/audio-list-status.txt"
    printf '{"status":"INFRA_ERROR","reason":"missing_or_non_executable_audio_list"}\n' > "$run_dir/audio-list-status.json"
    return 2
  fi
  local rc=0
  run_with_timeout "$enumeration_timeout" \
      "$run_dir/audio-list.txt" \
      "$run_dir/audio-list.err" \
      "$AUDIO_LIST_BIN" || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "core_audio_enumeration=PASS" > "$run_dir/audio-list-status.txt"
    printf '{"status":"PASS","exit_code":0,"signal":null,"timed_out":false}\n' > "$run_dir/audio-list-status.json"
    return 0
  fi
  if [ "$rc" = "124" ]; then
    echo "core_audio_enumeration=HUNG" > "$run_dir/audio-list-status.txt"
    printf '{"status":"HUNG","exit_code":124,"signal":null,"timed_out":true}\n' > "$run_dir/audio-list-status.json"
  elif [ "$rc" -ge 128 ]; then
    local signal_number=$((rc - 128))
    echo "core_audio_enumeration=SIGNALED" > "$run_dir/audio-list-status.txt"
    echo "return_code=$rc" >> "$run_dir/audio-list-status.txt"
    echo "signal=$signal_number" >> "$run_dir/audio-list-status.txt"
    printf '{"status":"SIGNALED","exit_code":null,"signal":%s,"timed_out":false}\n' "$signal_number" > "$run_dir/audio-list-status.json"
  else
    echo "core_audio_enumeration=FAIL" > "$run_dir/audio-list-status.txt"
    echo "return_code=$rc" >> "$run_dir/audio-list-status.txt"
    printf '{"status":"FAIL","exit_code":%s,"signal":null,"timed_out":false}\n' "$rc" > "$run_dir/audio-list-status.json"
  fi
  return 1
}

evaluate() {
  local top_rc=0
  top_snapshot "$run_dir/top.txt" || top_rc=$?
  local idle_pct
  idle_pct="$(top_idle_pct "$run_dir/top.txt")"
  local opena8dj_state
  local stale_driver_pids
  opena8dj_state="$(hal_state)"
  stale_driver_pids="$("$PGREP_BIN" -f '[C]ore Audio Driver \(OpenA8DJ.driver\)' 2>/dev/null || true)"
  echo "opena8dj_state=$opena8dj_state" > "$run_dir/hal-state.txt"
  echo "opena8dj_driver_pids=${stale_driver_pids:-none}" >> "$run_dir/hal-state.txt"

  local health_rc=0
  local enum_rc=0
  local stale_rc=0
  local infra_reason=""
  health_check || health_rc=$?
  enumeration_check || enum_rc=$?
  if [ "$top_rc" != "0" ] || [ -z "$idle_pct" ]; then
    infra_reason="top_probe_failed_or_missing_idle"
  elif { [ "$health_rc" != "0" ] && [ "$health_rc" != "1" ]; } || [ "$enum_rc" = "2" ]; then
    infra_reason="health_or_enumeration_probe_infrastructure_error"
  fi
  if [ "$opena8dj_state" = "unloaded" ] && [ -n "$stale_driver_pids" ]; then
    stale_rc=1
  fi

  {
    echo "audio_stack_guard_run_dir=$run_dir"
    echo "opena8dj_state=$opena8dj_state"
    echo "opena8dj_driver_pids=${stale_driver_pids:-none}"
    echo "global_cpu_idle_pct=$idle_pct"
    echo "min_idle_pct=$min_idle_pct"
    cat "$run_dir/audio-stack-health.txt"
    cat "$run_dir/audio-stack-health-status.json"
    cat "$run_dir/audio-list-status.txt"
    local idle_ok="0"
    if awk -v idle="$idle_pct" -v min="$min_idle_pct" 'BEGIN {exit !(idle >= min)}'; then
      idle_ok="1"
    fi
    if [ -n "$infra_reason" ]; then
      echo "audio_stack_guard=INFRA_ERROR"
      echo "error=$infra_reason"
      return 2
    fi
    if [ "$health_rc" = "0" ] && [ "$enum_rc" = "0" ] && [ "$idle_ok" = "1" ] && [ "$stale_rc" = "0" ]; then
      echo "audio_stack_guard=PASS"
      return 0
    fi
    if [ "$idle_ok" != "1" ] || [ "$health_rc" = "1" ]; then
      echo "audio_stack_guard=ENVIRONMENT_BUSY"
      echo "error=preflight_health_window_exceeded"
      return 3
    fi
    if [ "$idle_ok" != "1" ]; then
      echo "error=global_cpu_idle_below_threshold"
    fi
    if [ "$stale_rc" != "0" ]; then
      echo "error=stale_opena8dj_driver_process"
    fi
    echo "audio_stack_guard=FAIL"
    return 1
  } > "$run_dir/summary.txt"
}

evaluate_rc=0
evaluate || evaluate_rc=$?
cat "$run_dir/summary.txt"
exit "$evaluate_rc"
