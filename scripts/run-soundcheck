#!/usr/bin/env python3
import argparse
import datetime as dt
import json
import math
import os
import subprocess
import sys
import time
from pathlib import Path


def repo_root():
    return Path(__file__).resolve().parents[1]


def run(command, cwd, stdout=None, stderr=None, check=True):
    result = subprocess.run(command, cwd=str(cwd), stdout=stdout, stderr=stderr)
    if check and result.returncode != 0:
        raise SystemExit(f"command failed ({result.returncode}): {' '.join(str(part) for part in command)}")
    return result


def make_tools(root, skip_build):
    if skip_build:
        return
    run([
        "make",
        "build/audio-wav-play",
        "build/audio-config",
        "build/audio-record",
        "build/opena8dj-control",
    ], root)


def run_id():
    return dt.datetime.now().strftime("%Y-%m-%dT%H%M%S")


def parse_prepare_metadata(path):
    with open(path, "r", encoding="utf-8") as file:
        return json.load(file)


def write_summary(path, lines):
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


class HardwareLock:
    def __init__(self, root, purpose, evidence, actions, forbidden):
        self.root = Path(os.environ.get(
            "AUDIO_GATE_LOCK_ROOT",
            str(Path.home() / ".opena8dj" / "hardware-gate.lock"),
        ))
        self.repo_root = root
        self.purpose = purpose
        self.evidence = evidence
        self.actions = actions
        self.forbidden = forbidden
        self.acquired = False

    @staticmethod
    def _pid_alive(pid_text):
        try:
            pid = int(pid_text)
        except (TypeError, ValueError):
            return False
        try:
            os.kill(pid, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True

    def _owner_pid(self):
        owner = self.root / "owner"
        if not owner.is_file():
            return ""
        for line in owner.read_text(encoding="utf-8", errors="replace").splitlines():
            if line.startswith("pid="):
                return line.split("=", 1)[1]
        return ""

    def _cleanup_stale(self):
        if not self.root.exists():
            return
        owner_pid = self._owner_pid()
        if owner_pid and not self._pid_alive(owner_pid):
            import shutil
            shutil.rmtree(self.root)

    def __enter__(self):
        self._cleanup_stale()
        if os.environ.get("OPENA8DJ_HARDWARE_LOCK_HELD") == "1":
            owner_pid = self._owner_pid()
            if owner_pid and self._pid_alive(owner_pid):
                return self
        try:
            self.root.mkdir()
        except FileExistsError:
            print("audio_gate_lock=BUSY", file=sys.stderr)
            owner = self.root / "owner"
            if owner.is_file():
                print(owner.read_text(encoding="utf-8", errors="replace"), file=sys.stderr)
            raise SystemExit(75)
        self.acquired = True
        os.environ["OPENA8DJ_HARDWARE_LOCK_HELD"] = "1"
        owner_lines = [
            f"pid={os.getpid()}",
            "owner=codex",
            f"worktree={self.repo_root}",
            f"purpose={self.purpose}",
            f"started_at={dt.datetime.now().strftime('%Y-%m-%dT%H:%M:%S%z')}",
            f"actions_authorized={self.actions}",
            f"forbidden={self.forbidden}",
            f"evidence={self.evidence}",
        ]
        (self.root / "owner").write_text("\n".join(owner_lines) + "\n", encoding="utf-8")
        return self

    def __exit__(self, exc_type, exc, tb):
        if self.acquired:
            import shutil
            shutil.rmtree(self.root, ignore_errors=True)
        return False


VIRTUAL_CAPTURE_HINTS = (
    "blackhole",
    "soundflower",
    "vb-cable",
    "vbcable",
    "background music",
    "loopback audio",
    "rogue amoeba loopback",
)


def looks_like_virtual_capture(name):
    if not name:
        return False
    normalized = name.strip().lower()
    return any(hint in normalized for hint in VIRTUAL_CAPTURE_HINTS)


