]


CPU_ENTITY_PATTERNS = {
    "coreaudiod": ("coreaudiod",),
    "opena8dj_driver": ("OpenA8DJ.driver", "Core Audio Driver"),
    "windowserver": ("WindowServer",),
    "controlcenter": ("ControlCenter",),
    "audio_services": (
        "audiomxd",
