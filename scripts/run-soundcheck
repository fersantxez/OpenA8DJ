def capture_stream_stats(root, control, timeout_seconds):
    try:
        result = subprocess.run([str(control), "stream-stats"],
                                cwd=str(root),
                                stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT,
                                text=True,
                                timeout=timeout_seconds)
        return result.stdout, None
    except subprocess.TimeoutExpired:
        return "", f"stream-stats-timeout={timeout_seconds:.3f}s"
    except OSError as error:
        return "", f"stream-stats-error={error}"


def capture_transfer_ledger(root, control, timeout_seconds, count=48, all_entries=False):
    command = [str(control), "transfer-ledger"]
    if all_entries:
        command.append("--all")
    else:
        command.append(str(count))
    try:
        result = subprocess.run(command,
                                cwd=str(root),
                                stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT,
                                text=True,
                                timeout=timeout_seconds)
        if result.returncode != 0:
            return result.stdout, f"transfer-ledger-rc={result.returncode}"
        return result.stdout, None
    except subprocess.TimeoutExpired:
        return "", f"transfer-ledger-timeout={timeout_seconds:.3f}s"
    except OSError as error:
        return "", f"transfer-ledger-error={error}"


def parse_stream_stats(text):
    values = {}
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or "=" not in stripped:
            continue
        key, value = stripped.split("=", 1)
        key = key.strip()
        value = value.strip()
        if key:
            values[key] = value
    return values


def write_stream_stats_snapshot(root, base_dir, label, timeout_seconds):
    control = root / "build" / "opena8dj-control"
    path = base_dir / f"stream-stats-{label}.txt"
    text, error = capture_stream_stats(root, control, timeout_seconds)
    with open(path, "w", encoding="utf-8") as file:
        file.write(f"# sample_time={time.time():.3f}\n")
        if error:
            file.write(f"{error}\n")
        else:
            file.write(text)
            if text and not text.endswith("\n"):
                file.write("\n")
    return path


def write_transfer_ledger_snapshot(root, base_dir, label, timeout_seconds):
    control = root / "build" / "opena8dj-control"
    path = base_dir / f"transfer-ledger-{label}.tsv"
    text, error = capture_transfer_ledger(root, control, max(timeout_seconds, 10.0), all_entries=True)
    with open(path, "w", encoding="utf-8") as file:
        file.write(f"# sample_time={time.time():.3f}\n")
        if error:
            file.write(f"{error}\n")
        if text:
            file.write(text)
            if not text.endswith("\n"):
                file.write("\n")
    return path


def write_stream_stats_tsv_header(file):
    file.write("\t".join(STREAM_STATS_TSV_COLUMNS) + "\n")


def write_stream_stats_tsv_sample(file,
                                  sample_index,
                                  playback_start_monotonic,
                                  stress_active,
                                  stress_workers,
                                  stats_text,
                                  stats_error):
    now_monotonic = time.monotonic()
    values = {
        "schema_version": 1,
        "sample_index": sample_index,
        "sample_time_epoch": time.time(),
        "elapsed_seconds": now_monotonic - playback_start_monotonic,
        "stress_active": 1 if stress_active else 0,
        "active_stress_workers": stress_workers if stress_active else 0,
        "status": "ERROR" if stats_error else "OK",
    }
    values.update(parse_stream_stats(stats_text))
    row = []
    for column in STREAM_STATS_TSV_COLUMNS:
        value = str(values.get(column, ""))
        row.append(value.replace("\t", " ").replace("\n", " "))
    file.write("\t".join(row) + "\n")
    file.flush()


def stream_stats_once(root, control, file, timeout_seconds):
    file.write(f"# sample_time={time.time():.3f}\n")
    text, error = capture_stream_stats(root, control, timeout_seconds)
    if error:
        file.write(f"{error}\n")
    else:
        file.write(text)
    file.write("\n")
    file.flush()


def run_audio_stack_health(root, base_dir, args):
    if args.skip_audio_stack_health or args.prepare_only:
        return
    guard_script = root / "scripts" / "audio-stack-guard"
    health_script = root / "scripts" / "audio-stack-health"
    if not guard_script.exists() and not health_script.exists():
        return
    health_log = base_dir / "audio-stack-health-before.txt"
    if guard_script.exists():
        command = [
            str(guard_script),
            "--threshold",
            str(args.audio_stack_threshold),
            "--total-threshold",
            str(args.audio_stack_total_threshold),
            "--wait",
            str(args.audio_stack_wait),
            "--enumeration-timeout",
            str(args.audio_stack_enumeration_timeout),
            "--min-idle-pct",
            str(args.audio_stack_min_idle_pct),
            "--run-dir",
            str(base_dir / "audio-stack-guard-before"),
        ]
        if args.audio_stack_recover_on_fail:
            command.append("--recover")
            if args.audio_stack_unload_on_recover:
                command.append("--unload-opena8dj")
        with open(health_log, "w", encoding="utf-8") as log:
            result = subprocess.run(command, cwd=str(root), stdout=log, stderr=subprocess.STDOUT)
        if result.returncode != 0:
            write_summary(base_dir / "summary.txt", [
                "SOUNDCHECK: BLOCKED",
                "audio stack guard failed before playback",
                f"health_log={health_log}",
                f"guard_dir={base_dir / 'audio-stack-guard-before'}",
                f"run_dir={base_dir}",
            ])
            raise SystemExit(f"audio stack guard failed; see {health_log}")
        return

    with open(health_log, "w", encoding="utf-8") as log:
        result = subprocess.run([
            str(health_script),
            "--threshold",
            str(args.audio_stack_threshold),
            "--total-threshold",
            str(args.audio_stack_total_threshold),
            "--wait",
            str(args.audio_stack_wait),
        ], cwd=str(root), stdout=log, stderr=subprocess.STDOUT)
    if result.returncode != 0:
        write_summary(base_dir / "summary.txt", [
            "SOUNDCHECK: BLOCKED",
            "audio stack is not idle enough for a reliable pass",
            f"health_log={health_log}",
            f"run_dir={base_dir}",
        ])
        raise SystemExit(f"audio stack health failed; see {health_log}")


def classify_cpu_line(line):
    parts = line.strip().split(None, 3)
    if len(parts) < 4:
        return None
    try:
        int(parts[0])
        cpu = float(parts[1])
    except ValueError:
        return None
    text = parts[3]
    matches = []
    for entity, patterns in CPU_ENTITY_PATTERNS.items():
        if any(pattern in text for pattern in patterns):
            matches.append(entity)
    if not matches:
        return None
    return cpu, matches


def sample_cpu():
    totals = {entity: 0.0 for entity in CPU_ENTITY_PATTERNS}
    try:
        result = subprocess.run(["ps", "-axo", "pid,pcpu,rss,comm,args"],
                                stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE,
                                text=True,
                                timeout=1.0)
    except (OSError, subprocess.TimeoutExpired):
        return totals
    if result.returncode != 0:
        return totals
    for line in result.stdout.splitlines():
        classified = classify_cpu_line(line)
        if not classified:
            continue
        cpu, matches = classified
        for entity in matches:
            totals[entity] += cpu
    audio_ui_entities = [
        "coreaudiod",
        "opena8dj_driver",
        "windowserver",
        "controlcenter",
        "audio_services",
        "codex_audio_service",
    ]
    totals["top_audio_ui"] = max(totals.get(entity, 0.0) for entity in audio_ui_entities)
    totals["total_audio_ui"] = sum(totals.get(entity, 0.0) for entity in audio_ui_entities)
    try:
        totals["system_load1"] = os.getloadavg()[0]
    except OSError:
        totals["system_load1"] = 0.0
    return totals


def opena8dj_driver_pid():
    try:
        result = subprocess.run([
            "pgrep",
            "-f",
            r"[C]ore Audio Driver \(OpenA8DJ.driver\)",
        ], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=1.0)
    except (OSError, subprocess.TimeoutExpired):
        return ""
    if result.returncode != 0:
        return ""
    for line in result.stdout.splitlines():
        value = line.strip()
        if value.isdigit():
            return value
    return ""


def start_driver_sample(base_dir, args):
    sample_dir = base_dir / "driver-sample"
    sample_dir.mkdir(parents=True, exist_ok=True)
    status_path = sample_dir / "status.json"
    pid = opena8dj_driver_pid()
    if not pid:
        status_path.write_text(json.dumps({
            "schema": "opena8djcpp.soundcheck-driver-sample.v1",
            "result": "SKIPPED",
            "reason": "opena8dj_driver_pid_not_found",
        }, indent=2) + "\n", encoding="utf-8")
        return None
    output_path = sample_dir / "opena8dj-driver.sample.txt"
    command = [
        "sudo",
        "-n",
        "sample",
        pid,
        str(max(1, int(math.ceil(args.sample_driver_seconds)))),
        "-file",
        str(output_path),
    ]
    try:
        process = subprocess.Popen(command,
                                   stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE,
                                   text=True)
    except OSError as error:
        status_path.write_text(json.dumps({
            "schema": "opena8djcpp.soundcheck-driver-sample.v1",
            "result": "SKIPPED",
            "pid": pid,
            "reason": f"sample_start_failed:{error}",
        }, indent=2) + "\n", encoding="utf-8")
        return None
    status_path.write_text(json.dumps({
        "schema": "opena8djcpp.soundcheck-driver-sample.v1",
        "result": "RUNNING",
        "pid": pid,
        "duration_seconds": max(1, int(math.ceil(args.sample_driver_seconds))),
        "output": str(output_path),
        "command": command,
    }, indent=2) + "\n", encoding="utf-8")
    return {
        "process": process,
        "pid": pid,
        "output": output_path,
        "status": status_path,
        "started_at": time.time(),
    }


def finish_driver_sample(sampler):
    if not sampler:
        return
    process = sampler["process"]
    try:
        stdout, stderr = process.communicate(timeout=3.0)
    except subprocess.TimeoutExpired:
        process.terminate()
        try:
            stdout, stderr = process.communicate(timeout=1.0)
        except subprocess.TimeoutExpired:
            process.kill()
            stdout, stderr = process.communicate()
    output_path = sampler["output"]
    analysis_path = output_path.parent / "analysis.json"
    analysis_rc = None
    analysis_error = ""
    if output_path.exists():
        analyzer = repo_root() / "scripts" / "analyze-driver-sample"
        try:
            analysis = subprocess.run([
                str(analyzer),
                str(output_path),
                "--json-out",
                str(analysis_path),
            ], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=3.0)
            analysis_rc = analysis.returncode
            analysis_error = analysis.stderr.strip()
        except (OSError, subprocess.TimeoutExpired) as error:
            analysis_rc = -1
            analysis_error = str(error)
    sampler["status"].write_text(json.dumps({
        "schema": "opena8djcpp.soundcheck-driver-sample.v1",
        "result": "PASS" if process.returncode == 0 and output_path.exists() else "FAIL",
        "pid": sampler["pid"],
        "returncode": process.returncode,
        "elapsed_seconds": time.time() - sampler["started_at"],
        "output": str(output_path),
        "output_exists": output_path.exists(),
        "analysis": str(analysis_path),
        "analysis_exists": analysis_path.exists(),
        "analysis_returncode": analysis_rc,
        "analysis_error": analysis_error,
        "stdout": stdout.strip(),
        "stderr": stderr.strip(),
    }, indent=2) + "\n", encoding="utf-8")


def stress_worker_count(value):
    if value == "auto":
        return max(1, min(4, (os.cpu_count() or 2) // 2))
    try:
        return max(0, int(value))
    except ValueError:
        raise SystemExit(f"invalid --cpu-stress-workers value: {value}")


def start_cpu_stress(worker_count, duration_seconds):
    workers = []
    code = (
        "import math,time\n"
        f"end=time.time()+{max(0.1, duration_seconds):.6f}\n"
        "x=0.0\n"
        "while time.time()<end:\n"
        "    for _ in range(20000):\n"
        "        x=math.sin(x+1.000001)\n"
    )
    for _index in range(worker_count):
        workers.append(subprocess.Popen([sys.executable, "-c", code],
                                        stdout=subprocess.DEVNULL,
                                        stderr=subprocess.DEVNULL))
    return workers


def stop_cpu_stress(workers):
    for worker in workers:
        if worker.poll() is None:
            worker.terminate()
    deadline = time.time() + 1.0
    for worker in workers:
        while worker.poll() is None and time.time() < deadline:
            time.sleep(0.02)
        if worker.poll() is None:
            worker.kill()


def write_cpu_sample(file, sample_index, playback_start_monotonic, stress_active, stress_workers):
    now_monotonic = time.monotonic()
    values = {
        "schema_version": 1,
        "sample_index": sample_index,
        "sample_time_epoch": time.time(),
        "elapsed_seconds": now_monotonic - playback_start_monotonic,
        "stress_active": 1 if stress_active else 0,
        "active_stress_workers": stress_workers if stress_active else 0,
    }
    values.update(sample_cpu())
    file.write("\t".join(str(values.get(column, 0.0)) for column in CPU_PROFILE_COLUMNS))
    file.write("\n")
    file.flush()


def monitor_playback(root, base_dir, playback_process, args, playback_start_monotonic):
    control = root / "build" / "opena8dj-control"
    stress_workers = []
    worker_count = stress_worker_count(args.cpu_stress_workers)
    stress_started = False
    stress_finished = False
    sample_index = 0
    interval = max(0.05, args.cpu_profile_interval)
    stream_file = None
    legacy_stream_file = None
    stream_tsv_file = None
    cpu_file = None
    driver_sampler = None
    driver_sample_started = False
    try:
        if args.monitor_stream_stats:
            stream_stats_txt = base_dir / ("stream-stats-during.txt" if args.stream_stats_snapshots else "stream-stats.txt")
            stream_file = open(stream_stats_txt, "w", encoding="utf-8")
            if args.stream_stats_snapshots:
                legacy_stream_file = open(base_dir / "stream-stats.txt", "w", encoding="utf-8")
                stream_tsv_file = open(base_dir / "stream-stats-during.tsv", "w", encoding="utf-8")
                write_stream_stats_tsv_header(stream_tsv_file)
        if args.cpu_profile:
            cpu_file = open(base_dir / "cpu-profile.tsv", "w", encoding="utf-8")
            cpu_file.write("\t".join(CPU_PROFILE_COLUMNS) + "\n")
        while playback_process.poll() is None:
            elapsed = time.monotonic() - playback_start_monotonic
            if args.cpu_stress and not stress_started and elapsed >= args.cpu_stress_after:
                stress_workers = start_cpu_stress(worker_count, args.cpu_stress_seconds)
                stress_started = True
            if (stress_started
                    and not stress_finished
                    and elapsed >= args.cpu_stress_after + args.cpu_stress_seconds):
                stop_cpu_stress(stress_workers)
                stress_finished = True
            if (args.sample_driver_process
                    and not driver_sample_started
                    and elapsed >= args.sample_driver_delay):
                driver_sampler = start_driver_sample(base_dir, args)
                driver_sample_started = True
            stats_text = ""
            stats_error = ""
            if args.monitor_stream_stats:
                stats_text, stats_error = capture_stream_stats(root, control, args.monitor_command_timeout)
                sample_time = time.time()
                for file in (stream_file, legacy_stream_file):
                    if not file:
                        continue
                    file.write(f"# sample_time={sample_time:.3f}\n")
                    if stats_error:
                        file.write(f"{stats_error}\n")
                    else:
                        file.write(stats_text)
                    file.write("\n")
                    file.flush()
                if stream_tsv_file:
                    write_stream_stats_tsv_sample(stream_tsv_file,
                                                  sample_index,
                                                  playback_start_monotonic,
                                                  stress_started and not stress_finished,
                                                  worker_count,
                                                  stats_text,
                                                  stats_error)
            if cpu_file:
                write_cpu_sample(cpu_file,
                                 sample_index,
                                 playback_start_monotonic,
                                 stress_started and not stress_finished,
                                 worker_count)
            sample_index += 1
            time.sleep(interval)
    finally:
        finish_driver_sample(driver_sampler)
        stop_cpu_stress(stress_workers)
        if stream_tsv_file:
            stream_tsv_file.close()
        if legacy_stream_file:
            legacy_stream_file.close()
        if stream_file:
            stream_file.close()
        if cpu_file:
            cpu_file.close()


def build_prepare_command(root, args, fixture_dir):
    command = [
        sys.executable,
        str(root / "scripts" / "prepare-music-fixture.py"),
        "--out-dir",
        str(fixture_dir),
        "--rate",
        str(args.rate),
        "--seconds",
        str(args.seconds),
        "--mode",
        args.mode,
        "--target-peak-db",
        str(args.target_peak_db),
    ]
    if args.music_file:
        command.extend(["--music-file", args.music_file])
    else:
        for music_dir in args.music_dir or [str(Path.home() / "Music"), str(Path.home() / "Downloads")]:
            command.extend(["--music-dir", music_dir])
    return command


def load_metrics(path):
    with open(path, "r", encoding="utf-8") as file:
        return json.load(file)


def soundcheck_summary(metadata, metrics, args):
    verdict = metrics.get("verdict", "FAIL")
    clicks = int(metrics.get("left_click_outliers", 0)) + int(metrics.get("right_click_outliers", 0))
    min_snr = min(float(metrics.get("left_snr_db", 0.0)), float(metrics.get("right_snr_db", 0.0)))
    mid_ratio = float(metrics.get("mid_band_residual_ratio", 0.0))
    mid_dbfs = float(metrics.get("mid_band_residual_dbfs", -240.0))
    high_ratio = float(metrics.get("high_band_residual_ratio", 0.0))
    high_dbfs = float(metrics.get("high_band_residual_dbfs", -240.0))
    quiet_mid_dbfs = float(metrics.get("quiet_mid_band_noise_dbfs", -240.0))
    cpu_corr = float(metrics.get("mid_band_cpu_corr_max", 0.0))
    cpu_corr_column = metrics.get("mid_band_cpu_corr_max_column", "")
    lines = [
        f"SOUNDCHECK {args.pair} {args.rate}/{args.buffer}: {verdict}",
        f"source={metadata.get('source_name', '')} offset={metadata.get('start_seconds', 0.0):.3f}s mode={metadata.get('mode', args.mode)}",
        f"alignment_score={float(metrics.get('alignment_score', 0.0)):.6f}",
        f"quality_alignment_score={float(metrics.get('quality_alignment_score', 0.0)):.6f}",
        f"time_warp={int(metrics.get('time_warp_enabled', 0))} drift_frames={int(metrics.get('time_warp_lag_drift_frames', 0))}",
        f"analog_snr_db={min_snr:.2f}",
        f"mid_band_1000_5000_residual_ratio={mid_ratio:.6f}",
        f"mid_band_1000_5000_residual_dbfs={mid_dbfs:.2f}",
        f"high_band_5000_12000_residual_ratio={high_ratio:.6f}",
        f"high_band_5000_12000_residual_dbfs={high_dbfs:.2f}",
        f"quiet_mid_band_noise_dbfs={quiet_mid_dbfs:.2f}",
        f"mid_band_cpu_corr={cpu_corr:.6f} source={cpu_corr_column}",
        f"click_outliers={clicks}",
        f"lag_jumps_gt_2_frames={metrics.get('lag_jumps_gt_2_frames', 0)}",
        f"capture_clipped_frames={metrics.get('capture_clipped_frames', 0)}",
    ]
    for error in metrics.get("errors", []):
        lines.append(f"error={error}")
    return lines


def main():
    parser = argparse.ArgumentParser(description="Run an OpenA8DJ soundcheck with real local music.")
    parser.add_argument("--music-file")
    parser.add_argument("--music-dir", action="append")
    parser.add_argument("--pair", default="A")
    parser.add_argument("--rate", type=int, default=48000)
    parser.add_argument("--buffer", type=int, default=512)
    parser.add_argument("--seconds", type=float, default=20.0)
    parser.add_argument("--mode", choices=("dense", "transient", "wideband", "start"), default="dense")
    parser.add_argument("--target-peak-db", type=float, default=-12.0)
    parser.add_argument("--capture-device")
    parser.add_argument("--capture-channels", default="1,2")
    parser.add_argument("--allow-virtual-capture", action="store_true")
    parser.add_argument("--run-dir")
    parser.add_argument("--prepare-only", action="store_true")
    parser.add_argument("--skip-build", action="store_true")
    parser.add_argument("--skip-config", action="store_true")
    parser.add_argument("--no-output-stream-usage", action="store_true",
                        help="pass --no-stream-usage to audio-wav-play for mainline-parity diagnostics")
    parser.add_argument("--max-lag", type=int, default=1024)
    parser.add_argument("--drift-profile", action="store_true")
    parser.add_argument("--time-warp", action="store_true", default=True)
    parser.add_argument("--no-time-warp", action="store_false", dest="time_warp")
    parser.add_argument("--time-warp-max-lag", type=int, default=128)
    parser.add_argument("--min-alignment", type=float, default=0.98)
    parser.add_argument("--min-snr-db", type=float, default=35.0)
    parser.add_argument("--max-clicks", type=int, default=10)
    parser.add_argument("--max-lag-jumps", type=int, default=0)
    parser.add_argument("--cpu-profile", action="store_true", default=True)
    parser.add_argument("--no-cpu-profile", action="store_false", dest="cpu_profile")
    parser.add_argument("--cpu-profile-interval", type=float, default=0.25)
    parser.add_argument("--cpu-stress", action="store_true")
    parser.add_argument("--cpu-stress-after", type=float, default=5.0)
    parser.add_argument("--cpu-stress-seconds", type=float, default=8.0)
    parser.add_argument("--cpu-stress-workers", default="auto")
    parser.add_argument("--sample-driver-process", action="store_true",
                        help="diagnostic: run sudo sample on the OpenA8DJ Core Audio driver during playback")
    parser.add_argument("--sample-driver-delay", type=float, default=1.0,
                        help="seconds after playback start before driver sampling begins")
    parser.add_argument("--sample-driver-seconds", type=float, default=7.0,
                        help="duration for sudo sample when --sample-driver-process is enabled")
    parser.add_argument("--monitor-command-timeout", type=float, default=1.0)
    parser.add_argument("--monitor-stream-stats", action="store_true", default=True)
    parser.add_argument("--no-monitor-stream-stats", action="store_false", dest="monitor_stream_stats",
                        help="skip stream-stats polling during playback; CPU profile can still run")
    parser.add_argument("--stream-stats-snapshots", action="store_true",
                        help="write stream-stats-before.txt, stream-stats-during.txt/.tsv, and stream-stats-after.txt")
    parser.add_argument("--skip-audio-stack-health", action="store_true")
    parser.add_argument("--audio-stack-threshold", type=float, default=25.0)
    parser.add_argument("--audio-stack-total-threshold", type=float, default=120.0)
    parser.add_argument("--audio-stack-wait", type=float, default=2.0)
    parser.add_argument("--audio-stack-enumeration-timeout", type=float, default=5.0)
    parser.add_argument("--audio-stack-min-idle-pct", type=float, default=20.0)
    parser.add_argument("--audio-stack-recover-on-fail", action="store_true")
    parser.add_argument("--audio-stack-unload-on-recover", action="store_true", default=True)
    parser.add_argument("--audio-stack-keep-opena8dj-on-recover",
                        action="store_false",
                        dest="audio_stack_unload_on_recover")
    parser.add_argument("--max-mid-band-residual-ratio", type=float, default=0.04)
    parser.add_argument("--max-high-band-residual-ratio", type=float, default=0.08)
    parser.add_argument("--max-quiet-mid-band-noise-dbfs", type=float, default=-58.0)
    parser.add_argument("--max-mid-band-cpu-corr", type=float, default=0.60)
    args = parser.parse_args()

    root = repo_root()
    base_dir = Path(args.run_dir).expanduser() if args.run_dir else root / "local-analysis" / "soundcheck" / run_id()
    base_dir.mkdir(parents=True, exist_ok=True)
    fixture_dir = base_dir / "fixture"

    if not args.prepare_only and not args.capture_device:
        write_summary(base_dir / "summary.txt", [
            "SOUNDCHECK: BLOCKED",
            "capture-device is required for analog loopback",
            f"run_dir={base_dir}",
        ])
        raise SystemExit("provide --capture-device, for example --capture-device default or an external recorder name")

    if (not args.prepare_only
            and not args.allow_virtual_capture
            and looks_like_virtual_capture(args.capture_device)):
        write_summary(base_dir / "summary.txt", [
            "SOUNDCHECK: BLOCKED",
            "capture-device appears to be a virtual/pre-device route",
            "use a real post-device capture input or pass --allow-virtual-capture for diagnostic-only runs",
            f"capture_device={args.capture_device}",
            f"run_dir={base_dir}",
        ])
        raise SystemExit(
            "capture-device appears virtual/pre-device; use a real post-device capture input"
        )

    lock_context = (
        HardwareLock(
            root,
            "physical-soundcheck",
            base_dir,
            "Open Audio 8 DJ playback, external capture, CoreAudio config for candidate device",
            "default-device-change,USB-reset,driver-install,system-reboot",
        )
        if not args.prepare_only
        else None
    )

    def run_locked():
        make_tools(root, args.skip_build)
        run_audio_stack_health(root, base_dir, args)
        return run_soundcheck_body(root, base_dir, fixture_dir, args)

    if lock_context is None:
        make_tools(root, args.skip_build)
        run_audio_stack_health(root, base_dir, args)
        return run_soundcheck_body(root, base_dir, fixture_dir, args)
    with lock_context:
        return run_locked()


def run_soundcheck_body(root, base_dir, fixture_dir, args):

    prepare_log = base_dir / "prepare.log"
    with open(prepare_log, "w", encoding="utf-8") as log:
        run(build_prepare_command(root, args, fixture_dir), root, stdout=log, stderr=subprocess.STDOUT)
    metadata = parse_prepare_metadata(fixture_dir / "source.json")
    reference = Path(metadata["reference_wav"])

    if args.prepare_only:
        summary = [
            f"SOUNDCHECK PREFLIGHT: READY",
            f"source={metadata.get('source_name', '')}",
            f"reference={reference}",
            f"mode={metadata.get('mode', args.mode)}",
            f"rate={metadata.get('rate', args.rate)}",
            f"seconds={metadata.get('seconds', args.seconds)}",
            f"run_dir={base_dir}",
        ]
        write_summary(base_dir / "summary.txt", summary)
        print("\n".join(summary))
        return 0

    if not args.skip_config:
        with open(base_dir / "audio-config.log", "w", encoding="utf-8") as log:
            run([
                str(root / "build" / "audio-config"),
                "org.opena8dj.Audio8DJ",
                str(args.rate),
                str(args.buffer),
            ], root, stdout=log, stderr=subprocess.STDOUT)

    if args.stream_stats_snapshots:
        write_stream_stats_snapshot(root, base_dir, "before", args.monitor_command_timeout)

    capture = base_dir / "captured.wav"
    record_seconds = int(math.ceil(args.seconds + 2.0))
    record_log = open(base_dir / "record.log", "w", encoding="utf-8")
    play_log = open(base_dir / "play.log", "w", encoding="utf-8")
    try:
        recorder = subprocess.Popen([
            str(root / "build" / "audio-record"),
            str(record_seconds),
            str(capture),
            args.capture_device,
            args.capture_channels,
        ], cwd=str(root), stdout=record_log, stderr=subprocess.STDOUT)
        time.sleep(0.6)
        playback_start_monotonic = time.monotonic()
        player_command = [
            str(root / "build" / "audio-wav-play"),
            str(reference),
            args.pair,
        ]
        if args.no_output_stream_usage:
            player_command.append("--no-stream-usage")
        player = subprocess.Popen(player_command, cwd=str(root), stdout=play_log, stderr=subprocess.STDOUT)
        monitor_playback(root, base_dir, player, args, playback_start_monotonic)
        player_rc = player.wait()
        recorder_rc = recorder.wait()
    finally:
        record_log.close()
        play_log.close()

    if args.stream_stats_snapshots:
        write_stream_stats_snapshot(root, base_dir, "after", args.monitor_command_timeout)
        write_transfer_ledger_snapshot(root, base_dir, "after", args.monitor_command_timeout)

    if player_rc != 0 or recorder_rc != 0:
        write_summary(base_dir / "summary.txt", [
            "SOUNDCHECK: FAIL",
            f"player_rc={player_rc}",
            f"recorder_rc={recorder_rc}",
            *(["stream_stats_before=stream-stats-before.txt",
               "stream_stats_during=stream-stats-during.txt",
               "stream_stats_during_tsv=stream-stats-during.tsv",
               "stream_stats_after=stream-stats-after.txt",
               "transfer_ledger_after=transfer-ledger-after.tsv"] if args.stream_stats_snapshots else []),
            f"run_dir={base_dir}",
        ])
        raise SystemExit(f"soundcheck playback/record failed; see {base_dir}")

    metrics_json = base_dir / "metrics.json"
    analysis_txt = base_dir / "analysis.txt"
    analysis_err = base_dir / "analysis.err"
    cpu_profile_path = base_dir / "cpu-profile.tsv"
    coupling_profile_path = base_dir / "coupling-profile.json"
    with open(analysis_txt, "w", encoding="utf-8") as out, open(analysis_err, "w", encoding="utf-8") as err:
        analysis = run([
            sys.executable,
            str(root / "scripts" / "analyze-soundcheck-capture.py"),
            str(reference),
            str(capture),
            "--max-seconds",
            str(args.seconds),
            "--max-lag",
            str(args.max_lag),
            *(["--time-warp"] if args.time_warp else []),
            "--time-warp-max-lag",
            str(args.time_warp_max_lag),
            *(["--drift-profile"] if args.drift_profile else []),
            "--min-alignment",
            str(args.min_alignment),
            "--min-snr-db",
            str(args.min_snr_db),
            "--max-clicks",
            str(args.max_clicks),
            "--max-lag-jumps",
            str(args.max_lag_jumps),
            *(["--cpu-profile", str(cpu_profile_path)] if cpu_profile_path.exists() else []),
            "--coupling-profile-out",
            str(coupling_profile_path),
            "--max-mid-band-residual-ratio",
            str(args.max_mid_band_residual_ratio),
            "--max-high-band-residual-ratio",
            str(args.max_high_band_residual_ratio),
            "--max-quiet-mid-band-noise-dbfs",
            str(args.max_quiet_mid_band_noise_dbfs),
            "--max-mid-band-cpu-corr",
            str(args.max_mid_band_cpu_corr),
            "--json-out",
            str(metrics_json),
        ], root, stdout=out, stderr=err, check=False)

    if metrics_json.exists():
        metrics = load_metrics(metrics_json)
    else:
        analysis_error = "analysis did not produce metrics"
        if analysis_err.exists():
            error_text = analysis_err.read_text(encoding="utf-8", errors="replace").strip()
            if error_text:
                analysis_error = error_text.splitlines()[0]
        metrics = {"verdict": "FAIL", "errors": [analysis_error]}
    summary = soundcheck_summary(metadata, metrics, args)
    if args.stream_stats_snapshots:
        summary.extend([
            "stream_stats_before=stream-stats-before.txt",
            "stream_stats_during=stream-stats-during.txt",
            "stream_stats_during_tsv=stream-stats-during.tsv",
            "stream_stats_after=stream-stats-after.txt",
            "transfer_ledger_after=transfer-ledger-after.tsv",
        ])
    if args.sample_driver_process:
        summary.extend([
            "driver_sample_status=driver-sample/status.json",
            "driver_sample_output=driver-sample/opena8dj-driver.sample.txt",
            "driver_sample_analysis=driver-sample/analysis.json",
        ])
    summary.append(f"run_dir={base_dir}")
    write_summary(base_dir / "summary.txt", summary)
    print("\n".join(summary))
    return 0 if analysis.returncode == 0 and metrics.get("verdict") == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())
