#!/usr/bin/env python3
import argparse
import atexit
import datetime as dt
import json
import math
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path


def repo_root():
    return Path(__file__).resolve().parents[1]


class AudioGateLock:
    def __init__(self, root, run_dir, gate_name):
        lock_override = os.environ.get("AUDIO_GATE_LOCK_ROOT")
        self.lock_dir = Path(lock_override) if lock_override else Path.home() / ".opena8dj" / "hardware-gate.lock"
        self.root = root
        self.run_dir = run_dir
        self.gate_name = gate_name
        self.acquired = False
        self.inherited = False
        self.error = None

    def _owner(self):
        owner_path = self.lock_dir / "owner"
        values = {}
        try:
            for line in owner_path.read_text(encoding="utf-8", errors="replace").splitlines():
                if "=" in line:
                    key, value = line.split("=", 1)
                    values[key] = value
        except FileNotFoundError:
            pass
        return values

    @staticmethod
    def _pid_alive(pid):
        try:
            pid_int = int(pid)
        except (TypeError, ValueError):
            return False
        try:
            os.kill(pid_int, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True

    def _write_status(self, status, extra=None):
        extra = extra or {}
        lines = [
            f"audio_gate_lock={status}",
            f"lock_dir={self.lock_dir}",
            f"gate={self.gate_name}",
        ]
        lines.extend(f"{key}={value}" for key, value in extra.items())
        (self.run_dir / "audio-gate-lock.txt").write_text("\n".join(lines) + "\n", encoding="utf-8")

    def acquire(self):
        self.run_dir.mkdir(parents=True, exist_ok=True)
        if os.environ.get("AUDIO_GATE_LOCK_HELD") == "1":
            self.inherited = True
            self._write_status("INHERITED", {
                "owner_gate": os.environ.get("AUDIO_GATE_LOCK_OWNER_GATE", "unknown"),
                "owner_run_dir": os.environ.get("AUDIO_GATE_LOCK_OWNER_RUN_DIR", "unknown"),
                "owner_cwd": os.environ.get("AUDIO_GATE_LOCK_OWNER_CWD", "unknown"),
            })
            return True
        self.lock_dir.parent.mkdir(parents=True, exist_ok=True)
        try:
            self.lock_dir.mkdir()
        except FileExistsError:
            owner = self._owner()
            owner_pid = owner.get("pid", "")
            if not self._pid_alive(owner_pid):
                shutil.rmtree(self.lock_dir, ignore_errors=True)
                try:
                    self.lock_dir.mkdir()
                except FileExistsError:
                    owner = self._owner()
                    self.error = "audio_gate_lock_busy"
                    self._write_status("BUSY", {
                        "owner_pid": owner.get("pid", "unknown"),
                        "owner_gate": owner.get("gate", "unknown"),
                        "owner_run_dir": owner.get("run_dir", "unknown"),
                    })
                    return False
                self.acquired = True
                self._write_owner({"recovered_stale_lock": "1", "stale_owner_pid": owner_pid or "unknown"})
                self._write_status("ACQUIRED_AFTER_STALE", {
                    "stale_owner_pid": owner_pid or "unknown",
                    "stale_owner_gate": owner.get("gate", "unknown"),
                    "stale_owner_run_dir": owner.get("run_dir", "unknown"),
                })
                return True
            self.error = "audio_gate_lock_busy"
            self._write_status("BUSY", {
                "owner_pid": owner_pid or "unknown",
                "owner_gate": owner.get("gate", "unknown"),
                "owner_run_dir": owner.get("run_dir", "unknown"),
            })
            return False
        self.acquired = True
        self._write_owner({})
        self._write_status("ACQUIRED")
        return True

    def _write_owner(self, extra):
        lines = [
            f"pid={os.getpid()}",
            f"gate={self.gate_name}",
            f"run_dir={self.run_dir}",
            f"cwd={self.root}",
            "started_at=" + dt.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ"),
        ]
        lines.extend(f"{key}={value}" for key, value in extra.items())
        (self.lock_dir / "owner").write_text("\n".join(lines) + "\n", encoding="utf-8")

    def release(self):
        if self.inherited or not self.acquired:
            return
        owner = self._owner()
        if owner.get("pid") == str(os.getpid()):
            shutil.rmtree(self.lock_dir, ignore_errors=True)


def run(command, cwd, stdout=None, stderr=None, check=True):
    result = subprocess.run(command, cwd=str(cwd), stdout=stdout, stderr=stderr)
    if check and result.returncode != 0:
        raise SystemExit(f"command failed ({result.returncode}): {' '.join(str(part) for part in command)}")
    return result


def make_tools(root, skip_build):
    if skip_build:
        return
    run([
        "make",
        "build/audio-wav-play",
        "build/audio-config",
        "build/audio-record",
        "build/opena8dj-control",
    ], root)


def run_id():
    return dt.datetime.now().strftime("%Y-%m-%dT%H%M%S")


def parse_prepare_metadata(path):
    with open(path, "r", encoding="utf-8") as file:
        return json.load(file)


def write_summary(path, lines):
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


VIRTUAL_CAPTURE_HINTS = (
    "blackhole",
    "soundflower",
    "vb-cable",
    "vbcable",
    "background music",
    "loopback audio",
    "rogue amoeba loopback",
)


def looks_like_virtual_capture(name):
    if not name:
        return False
    normalized = name.strip().lower()
    return any(hint in normalized for hint in VIRTUAL_CAPTURE_HINTS)


def looks_like_irig_capture(name):
    return bool(name) and "irig" in name.strip().lower()


