#!/usr/bin/env python3
"""Read-only preflight for the lock-gated physical superiority window.

This script does not play, record, install/uninstall HAL drivers, restart
CoreAudio, reset USB, change defaults, or acquire the hardware lock. It only
checks that the requested evidence window is well specified before the runner
is allowed to touch audio under lock.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
AUDIO8_USB_VENDOR_DECIMAL = 6092
AUDIO8_USB_PRODUCT_DECIMAL = 6520


def run_text(argv: list[str], timeout: int = 10) -> tuple[int, str, str]:
    try:
        completed = subprocess.run(
            argv,
            cwd=ROOT,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
            check=False,
        )
        return completed.returncode, completed.stdout, completed.stderr
    except subprocess.TimeoutExpired as exc:
        return 124, exc.stdout or "", exc.stderr or "timeout"


def resolve_path(value: str | None) -> Path | None:
    if not value:
        return None
    path = Path(value)
    if not path.is_absolute():
        path = ROOT / path
    return path


def audio8ish(value: str) -> bool:
    lowered = value.lower()
    return any(
        token in lowered
        for token in (
            "opena8dj",
            "open audio 8",
            "audio 8 dj",
            "org.opena8dj.audio8dj",
        )
    )


def built_in_or_acoustic_output(value: str) -> bool:
    lowered = value.lower()
    return any(
        token in lowered
        for token in (
            "builtinspeakerdevice",
            "built-in output",
            "built in output",
            "macbook air speakers",
            "macbook speakers",
        )
    )


def parse_audio_list(text: str) -> list[dict[str, object]]:
    devices: list[dict[str, object]] = []
    pattern = re.compile(
        r"^\s*\d+\s+id=(?P<id>\d+)\s+(?P<name>.*?)\s+uid=(?P<uid>.*?)\s+"
        r"in=(?P<inputs>\d+)\s+out=(?P<outputs>\d+)\s+rate=(?P<rate>[0-9.]+)"
    )
    for line in text.splitlines():
        match = pattern.match(line)
        if not match:
            continue
        devices.append(
            {
                "id": int(match.group("id")),
                "name": match.group("name").strip(),
                "uid": match.group("uid"),
                "inputs": int(match.group("inputs")),
                "outputs": int(match.group("outputs")),
                "rate": float(match.group("rate")),
            }
        )
    return devices


def device_matches(device: dict[str, object], name: str | None, uid: str | None) -> bool:
    device_name = str(device.get("name", ""))
    device_uid = str(device.get("uid", ""))
    if uid:
        return device_uid == uid
    if name:
        return name.lower() in device_name.lower()
    return False


def find_devices(devices: list[dict[str, object]], name: str | None, uid: str | None) -> list[dict[str, object]]:
    return [device for device in devices if device_matches(device, name, uid)]


def unique_device(matches: list[dict[str, object]]) -> dict[str, object] | None:
    return matches[0] if len(matches) == 1 else None


def usb_audio8_present() -> tuple[bool, dict[str, object]]:
    rc, stdout, stderr = run_text(["ioreg", "-p", "IOUSB", "-l", "-w0"], timeout=10)
    text = stdout + "\n" + stderr
    present = (
        "Audio 8 DJ" in text
        and f'"idVendor" = {AUDIO8_USB_VENDOR_DECIMAL}' in text
        and f'"idProduct" = {AUDIO8_USB_PRODUCT_DECIMAL}' in text
    )
    return present, {"return_code": rc, "name_match": "Audio 8 DJ" in text}


def lock_state() -> dict[str, object]:
    lock_root = Path(os.environ.get("AUDIO_GATE_LOCK_ROOT", str(Path.home() / ".opena8dj/hardware-gate.lock")))
    owner = lock_root / "owner"
    state: dict[str, object] = {"path": str(lock_root), "present": lock_root.exists()}
    if owner.is_file():
        text = owner.read_text(encoding="utf-8", errors="replace")
        state["owner"] = text.strip()
        pid_match = re.search(r"(?:pid|PID)=?(\d+)|^(\d+)$", text.strip())
        if pid_match:
            pid = int(pid_match.group(1) or pid_match.group(2))
            state["pid"] = pid
            try:
                os.kill(pid, 0)
                state["owner_alive"] = True
            except OSError:
                state["owner_alive"] = False
    return state


def gate(name: str, passed: bool, metrics: dict[str, object] | None = None, reason: str = "") -> dict[str, object]:
    return {
        "name": name,
        "result": "PASS" if passed else "FAIL",
        "metrics": metrics or {},
        "reason": reason,
    }


def hal_bundle_metrics(path: Path | None) -> dict[str, object]:
    executable = path / "Contents/MacOS/OpenA8DJHAL" if path is not None else None
    return {
        "path": str(path) if path else "",
        "bundle_exists": bool(path and path.is_dir()),
        "executable": str(executable) if executable else "",
        "executable_exists": bool(executable and executable.is_file()),
        "executable_bytes": executable.stat().st_size if executable and executable.is_file() else 0,
        "executable_sha256": sha256(executable) if executable and executable.is_file() else "",
    }


def hal_bundle_ready(path: Path | None) -> bool:
    metrics = hal_bundle_metrics(path)
    return bool(metrics["bundle_exists"] and metrics["executable_exists"] and metrics["executable_bytes"])


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_json(path: Path) -> dict[str, object]:
    try:
        with path.open("r", encoding="utf-8") as handle:
            parsed = json.load(handle)
            return parsed if isinstance(parsed, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def nested_dict(value: object) -> dict[str, object]:
    return value if isinstance(value, dict) else {}


def prepared_runtime_candidate_gate(candidate_metrics: dict[str, object]) -> dict[str, object]:
    candidate_hash = str(candidate_metrics.get("executable_sha256", ""))
    candidate_path = str(candidate_metrics.get("path", ""))
    prepared_candidate_path = ROOT / "local-analysis/cpp-offline/hal-prepared-runtime-candidate.json"
    prepared_bundle_path = ROOT / "local-analysis/cpp-offline/hal-prepared-runtime-bundle-complete.json"
    summary_path = ROOT / "local-analysis/cpp-offline/current-offline-gates.json"
    prepared = load_json(prepared_candidate_path)
    bundle = load_json(prepared_bundle_path)
    summary = load_json(summary_path)
    prepared_metrics = nested_dict(prepared.get("prepared_candidate"))
    summary_binding = nested_dict(summary.get("hal_prepared_runtime_binding_contract"))
    summary_transport = nested_dict(summary.get("hal_transport_runtime_gate"))
    offline_hash = str(prepared_metrics.get("executable_sha256", ""))
    offline_candidate = str(prepared.get("candidate", ""))
    gates = [
        gate(
            "prepared_runtime_candidate_requested",
            True,
            {"candidate": candidate_path},
            "prepared runtime candidate validation is explicit",
        ),
        gate(
            "prepared_runtime_candidate_offline_json_pass",
            prepared.get("result") == "PASS",
            {"path": str(prepared_candidate_path), "result": prepared.get("result", "")},
            "prepared-runtime candidate JSON must exist and pass",
        ),
        gate(
            "prepared_runtime_bundle_complete_json_pass",
            bundle.get("result") == "PASS",
            {"path": str(prepared_bundle_path), "result": bundle.get("result", "")},
            "prepared-runtime bundle completeness JSON must exist and pass",
        ),
        gate(
            "prepared_runtime_candidate_hash_matches_offline_artifact",
            bool(candidate_hash) and candidate_hash == offline_hash,
            {
                "candidate_executable_sha256": candidate_hash,
                "offline_executable_sha256": offline_hash,
                "offline_candidate": offline_candidate,
            },
            "physical window candidate executable must match the prepared offline artifact",
        ),
        gate(
            "prepared_runtime_dispatch_contract_pass",
            summary_binding.get("status") == "PASS"
            and summary_binding.get("prepared_runtime_dispatch_path_present") is True,
            {
                "summary": str(summary_path),
                "status": summary_binding.get("status", ""),
                "prepared_runtime_dispatch_path_present": summary_binding.get(
                    "prepared_runtime_dispatch_path_present", False
                ),
            },
            "prepared runtime dispatch contract must be present in current offline summary",
        ),
        gate(
            "prepared_runtime_transport_claim_blocked_until_physical",
            summary_transport.get("status") == "PASS"
            and summary_transport.get("runtime_reduction_missing") is True
            and summary_transport.get("hal_prepared_runtime_physical_evidence_present") is False,
            {
                "status": summary_transport.get("status", ""),
                "runtime_reduction_missing": summary_transport.get(
                    "runtime_reduction_missing", False
                ),
                "hal_prepared_runtime_physical_evidence_present": summary_transport.get(
                    "hal_prepared_runtime_physical_evidence_present", True
                ),
            },
            "prepared candidate can enter a physical window, but cannot claim superiority before physical evidence",
        ),
    ]
    return {
        "schema": "opena8djcpp.prepared-runtime-physical-window-candidate.v1",
        "requested": True,
        "candidate": candidate_path,
        "candidate_executable_sha256": candidate_hash,
        "offline_candidate": offline_candidate,
        "offline_executable_sha256": offline_hash,
        "evidence": {
            "prepared_runtime_candidate": str(prepared_candidate_path),
            "prepared_runtime_bundle_complete": str(prepared_bundle_path),
            "current_offline_gates": str(summary_path),
        },
        "gates": gates,
        "result": "PASS" if all(item["result"] == "PASS" for item in gates) else "FAIL",
        "physical_evidence_present": False,
        "product_claim_allowed": False,
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run-dir", default="")
    parser.add_argument("--capture-device", required=True)
    parser.add_argument("--capture-channels", default="1,2")
    parser.add_argument("--known-good-output-device", default="")
    parser.add_argument("--known-good-output-device-uid", default="")
    parser.add_argument("--reference-wav", default="")
    parser.add_argument("--music-file", default="")
    parser.add_argument("--mainline-candidate", default="")
    parser.add_argument("--candidate", default="")
    parser.add_argument("--prepared-runtime-candidate", action="store_true")
    parser.add_argument("--route-only", action="store_true")
    parser.add_argument("--candidate-only", action="store_true")
    parser.add_argument("--skip-known-good", action="store_true")
    parser.add_argument("--allow-same-device-loopback-diagnostic", action="store_true")
    parser.add_argument("--allow-built-in-output-acoustic-diagnostic", action="store_true")
    parser.add_argument("--json-out", default="")
    args = parser.parse_args()

    audio_list_path = ROOT / "build/audio-list"
    audio_rc, audio_stdout, audio_stderr = run_text([str(audio_list_path)], timeout=8) if audio_list_path.exists() else (127, "", "missing build/audio-list")
    devices = parse_audio_list(audio_stdout)

    capture_matches = find_devices(devices, args.capture_device, None)
    known_good_matches = find_devices(
        devices, args.known_good_output_device or None, args.known_good_output_device_uid or None
    )
    open_audio8_matches = find_devices(devices, "Open Audio 8 DJ", "org.opena8dj.Audio8DJ")
    capture = unique_device(capture_matches)
    known_good = unique_device(known_good_matches)
    open_audio8 = unique_device(open_audio8_matches)
    usb_present, usb_metrics = usb_audio8_present()

    reference_wav = resolve_path(args.reference_wav)
    music_file = resolve_path(args.music_file)
    mainline_candidate = resolve_path(args.mainline_candidate)
    candidate = resolve_path(args.candidate)
    lock = lock_state()

    requires_candidates = not args.route_only
    requires_mainline = requires_candidates and not args.candidate_only
    requires_known_good = not args.skip_known_good
    same_known_good_capture_device = (
        requires_known_good
        and capture is not None
        and known_good is not None
        and (
            str(capture.get("uid", "")) == str(known_good.get("uid", ""))
            or str(capture.get("name", "")).lower() == str(known_good.get("name", "")).lower()
        )
    )
    known_good_identity = " ".join(
        (
            args.known_good_output_device,
            args.known_good_output_device_uid,
            str((known_good or {}).get("name", "")),
            str((known_good or {}).get("uid", "")),
        )
    )
    built_in_known_good_output = requires_known_good and built_in_or_acoustic_output(known_good_identity)
    resolved_known_good_audio8 = requires_known_good and audio8ish(known_good_identity)

    mainline_candidate_metrics = hal_bundle_metrics(mainline_candidate)
    candidate_metrics = hal_bundle_metrics(candidate)
    prepared_runtime_report = (
        prepared_runtime_candidate_gate(candidate_metrics)
        if args.prepared_runtime_candidate and requires_candidates
        else {
            "schema": "opena8djcpp.prepared-runtime-physical-window-candidate.v1",
            "requested": False,
            "result": "SKIP",
        }
    )

    gates = [
        gate("audio_list_available", audio_rc == 0 and bool(devices), {"return_code": audio_rc, "device_count": len(devices)}, audio_stderr.strip()),
        gate(
            "irig_capture_unambiguous",
            len(capture_matches) == 1,
            {"match_count": len(capture_matches), "matches": capture_matches, "requested": args.capture_device},
            "capture selector must resolve exactly one CoreAudio device; use a more specific name if ambiguous",
        ),
        gate("irig_capture_visible", capture is not None and int(capture.get("inputs", 0)) >= 2, {"device": capture or {}, "requested": args.capture_device}, "capture device must be visible with at least two inputs"),
        gate("audio8_usb_visible", args.route_only or usb_present, usb_metrics, "Audio 8 DJ must be visible on USB before HAL install/reload"),
        gate("opena8dj_coreaudio_absent_or_valid", open_audio8 is None or (int(open_audio8.get("inputs", 0)) == 8 and int(open_audio8.get("outputs", 0)) == 8), {"device": open_audio8 or {}}, "if already loaded, Open Audio 8 DJ must expose 8 in / 8 out"),
        gate("mainline_candidate_complete", not requires_mainline or hal_bundle_ready(mainline_candidate), mainline_candidate_metrics, "mainline HAL bundle must include Contents/MacOS/OpenA8DJHAL"),
        gate("cpp_candidate_complete", not requires_candidates or hal_bundle_ready(candidate), candidate_metrics, "C++ HAL bundle must include Contents/MacOS/OpenA8DJHAL"),
        gate("prepared_runtime_candidate_evidence_bound", not args.prepared_runtime_candidate or not requires_candidates or prepared_runtime_report.get("result") == "PASS", prepared_runtime_report, "prepared runtime physical windows must match the offline prepared artifact and dispatch contract"),
        gate("reference_wav_exists", not requires_known_good or (reference_wav is not None and reference_wav.is_file()), {"path": str(reference_wav) if reference_wav else ""}, "known-good route reference WAV is required"),
        gate("music_file_exists_if_supplied", music_file is None or music_file.is_file(), {"path": str(music_file) if music_file else ""}, "music fixture must exist when supplied"),
        gate("known_good_output_specified", not requires_known_good or bool(args.known_good_output_device or args.known_good_output_device_uid), {"name": args.known_good_output_device, "uid": args.known_good_output_device_uid}, "explicit non-Audio8 output source is required"),
        gate(
            "known_good_output_unambiguous",
            not requires_known_good or len(known_good_matches) == 1,
            {"match_count": len(known_good_matches), "matches": known_good_matches},
            "known-good output selector must resolve exactly one CoreAudio device; use UID when name is ambiguous",
        ),
        gate("known_good_output_not_audio8", not resolved_known_good_audio8, {"name": args.known_good_output_device, "uid": args.known_good_output_device_uid, "resolved": known_good or {}}, "known-good source must not be OpenA8DJ/Audio 8"),
        gate("known_good_output_visible", not requires_known_good or (known_good is not None and int(known_good.get("outputs", 0)) >= 2), {"device": known_good or {}}, "known-good source must be a visible CoreAudio output with at least two channels"),
        gate("known_good_output_not_capture_device", not same_known_good_capture_device or args.allow_same_device_loopback_diagnostic, {"capture": capture or {}, "known_good": known_good or {}, "allow_same_device_loopback_diagnostic": args.allow_same_device_loopback_diagnostic}, "known-good source must not be the same CoreAudio device as the capture device unless explicitly diagnostic"),
        gate("known_good_output_not_builtin_acoustic", not built_in_known_good_output or args.allow_built_in_output_acoustic_diagnostic, {"device": known_good or {}, "allow_built_in_output_acoustic_diagnostic": args.allow_built_in_output_acoustic_diagnostic}, "built-in speakers/acoustic paths cannot validate the wired iRig route"),
        gate("hardware_lock_free", not bool(lock.get("present")) or lock.get("owner_alive") is False, lock, "hardware lock is currently owned"),
    ]

    passed = all(item["result"] == "PASS" for item in gates)
    report = {
        "schema": "opena8djcpp.physical-window-preflight.v1",
        "safety": "read_only_no_audio_playback_capture_driver_install_coreaudio_restart_usb_reset_or_default_change",
        "result": "PASS" if passed else "FAIL",
        "ready_to_execute_physical_window": passed,
        "route_only": args.route_only,
        "candidate_only": args.candidate_only,
        "skip_known_good": args.skip_known_good,
        "prepared_runtime_candidate": args.prepared_runtime_candidate,
        "prepared_runtime_candidate_report": prepared_runtime_report,
        "allow_same_device_loopback_diagnostic": args.allow_same_device_loopback_diagnostic,
        "allow_built_in_output_acoustic_diagnostic": args.allow_built_in_output_acoustic_diagnostic,
        "known_good_output_same_as_capture": same_known_good_capture_device,
        "known_good_output_builtin_or_acoustic": built_in_known_good_output,
        "known_good_output_match_count": len(known_good_matches),
        "capture_device_match_count": len(capture_matches),
        "devices": devices,
        "capture_channels": args.capture_channels,
        "audio8_coreaudio_visible": open_audio8 is not None,
        "gates": gates,
    }
    text = json.dumps(report, indent=2, sort_keys=True)
    print(text)
    if args.json_out:
        output = resolve_path(args.json_out)
        assert output is not None
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(text + "\n", encoding="utf-8")
    return 0 if passed else 1


if __name__ == "__main__":
    raise SystemExit(main())
