#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

candidate="current-loaded"
wait_seconds="7200"
interval_seconds="5"
stable_polls="3"
run_dir=""
to="fernandosanchezmunoz@gmail.com"

usage() {
  cat <<'EOF'
Usage: scripts/start-safe-replug-watch [options]

Starts the guarded iRig replug watcher in the background. The watcher is
read-only while iRig is absent: it polls USB/Core Audio state and does not reset
USB devices, restart Core Audio, reboot, or install a driver. If iRig returns,
it runs the existing candidate-watch/preflight/email-payload gate.

Options:
  --candidate NAME
  --wait SECONDS       Default: 7200
  --interval SECONDS   Default: 5
  --stable-polls COUNT Default: 3
  --run-dir DIR
  --to ADDRESS         Default: fernandosanchezmunoz@gmail.com
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --candidate) candidate="$2"; shift 2 ;;
    --wait) wait_seconds="$2"; shift 2 ;;
    --interval) interval_seconds="$2"; shift 2 ;;
    --stable-polls) stable_polls="$2"; shift 2 ;;
    --run-dir) run_dir="$2"; shift 2 ;;
    --to) to="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -z "$run_dir" ]; then
  safe_candidate="$(printf '%s' "$candidate" | tr -c '[:alnum:]_.-' '-')"
  run_dir="local-analysis/safe-replug-watch/${safe_candidate}-$(date +%Y%m%d-%H%M%S)"
fi
mkdir -p "$run_dir"

state_dir="local-analysis/safe-replug-watch"
mkdir -p "$state_dir"
current_file="$state_dir/current.env"
label="com.fer.opena8dj.safe-replug-watch"
plist="$HOME/Library/LaunchAgents/$label.plist"
uid="$(id -u)"

if [ -f "$current_file" ]; then
  old_pid="$(awk -F= '$1=="pid"{print $2; exit}' "$current_file" 2>/dev/null || true)"
  if [ -n "$old_pid" ] && ps -p "$old_pid" >/dev/null 2>&1; then
    old_run_dir="$(awk -F= '$1=="run_dir"{print substr($0, index($0, "=") + 1); exit}' "$current_file" 2>/dev/null || true)"
    {
      echo "safe_replug_watch=ALREADY_RUNNING"
      echo "pid=$old_pid"
      echo "run_dir=$old_run_dir"
      echo "current_file=$current_file"
    } | tee "$run_dir/result.txt"
    exit 0
  fi
fi

stdout="$run_dir/watch.stdout"
stderr="$run_dir/watch.stderr"
runner="$run_dir/run-watch.sh"
result="$run_dir/candidate-watch-ready-email-gate/result.txt"
root="$(pwd)"
runner_abs="$root/$runner"
stdout_abs="$root/$stdout"
stderr_abs="$root/$stderr"

cat >"$runner" <<EOF
#!/usr/bin/env bash
set -u
cd "$(pwd)" || exit 10
{
  echo "runner_started_at=\$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "candidate=$candidate"
  echo "run_dir=$run_dir"
  echo "wait_seconds=$wait_seconds"
  echo "interval_seconds=$interval_seconds"
  echo "stable_polls=$stable_polls"
} > "$run_dir/runner-start.txt"
./scripts/candidate-watch-ready-email-gate \\
  --candidate "$candidate" \\
  --wait "$wait_seconds" \\
  --interval "$interval_seconds" \\
  --stable-polls "$stable_polls" \\
  --to "$to" \\
  --run-dir "$run_dir/candidate-watch-ready-email-gate"
rc="\$?"
{
  echo "runner_finished_at=\$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "exit_code=\$rc"
  echo "result=$result"
} > "$run_dir/runner-finish.txt"
exit "\$rc"
EOF
chmod +x "$runner"

mkdir -p "$HOME/Library/LaunchAgents"
cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$runner_abs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>$root</string>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>$stdout_abs</string>
  <key>StandardErrorPath</key>
  <string>$stderr_abs</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
EOF

launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
launchctl bootstrap "gui/$uid" "$plist"
sleep 0.5
pid="$(launchctl print "gui/$uid/$label" 2>/dev/null | awk '/pid = /{print $3; exit}' || true)"

{
  echo "label=$label"
  echo "pid=${pid:-unknown}"
  echo "candidate=$candidate"
  echo "run_dir=$run_dir"
  echo "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "wait_seconds=$wait_seconds"
  echo "interval_seconds=$interval_seconds"
  echo "stable_polls=$stable_polls"
  echo "stdout=$stdout"
  echo "stderr=$stderr"
  echo "result=$result"
  echo "runner=$runner"
  echo "plist=$plist"
} >"$current_file"

{
  echo "safe_replug_watch=STARTED"
  echo "label=$label"
  echo "pid=${pid:-unknown}"
  echo "candidate=$candidate"
  echo "run_dir=$run_dir"
  echo "wait_seconds=$wait_seconds"
  echo "interval_seconds=$interval_seconds"
  echo "stable_polls=$stable_polls"
  echo "stdout=$stdout"
  echo "stderr=$stderr"
  echo "result=$result"
  echo "runner=$runner"
  echo "plist=$plist"
  echo "current_file=$current_file"
} | tee "$run_dir/result.txt"
