#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: scripts/run-physical-superiority-window --run-dir DIR --capture-device NAME --reference-wav PATH [options]

Plans or executes the lock-gated physical evidence window needed before any
claim that the C++ line beats mainline. By default this is dry-run only.

Execution sequence when --execute is present:
  1. acquire the global hardware lock for the whole window;
  2. validate a known-good non-Audio8 source through the iRig capture route;
  3. install/reload the explicit HAL candidate through test-hal-candidate-safety;
  4. run an Open Audio 8 DJ music soundcheck with CPU and stream evidence;
  5. run native C++ WAV quality analysis;
  6. run promotion-readiness evaluation against the new evidence;
  7. unload the candidate unless --leave-loaded is present.

This script does not change default devices, sample rate of arbitrary devices,
USB state, or reboot the system. It refuses to run physical work without
--execute.

Required for full execution:
  --execute
  --candidate PATH
  --known-good-output-device NAME or --known-good-output-device-uid UID
  --capture-device NAME
  --reference-wav PATH

Options:
  --execute                         Actually run the physical window
  --route-only                      Execute only the known-good route check
  --candidate PATH                  HAL candidate bundle for C++ run
  --known-good-output-device NAME   Explicit non-Audio8 source for route check
  --known-good-output-device-uid UID Explicit non-Audio8 source UID
  --capture-device NAME             Capture device, normally "iRig Stream"
  --capture-channels LIST           Capture channels, default 1,2
  --reference-wav PATH              Reference WAV for known-good route check
  --music-file PATH                 Music WAV/AIFF/etc for Audio 8 soundcheck
  --pair A|B|C|D                    Audio 8 pair, default A
  --seconds N                       Seconds for route and Audio 8 checks, default 12
  --rate N                          Audio 8 sample rate, default 48000
  --buffer N                        Audio 8 buffer, default 512
  --target-peak-db DB               Fixture target peak, default -16
  --run-dir DIR                     Evidence directory
  --skip-build                      Reuse existing built tools
  --skip-known-good                 Skip route validation; diagnostic only
  --leave-loaded                    Leave HAL candidate loaded after success
  -h, --help                        Show this help
USAGE
}

repo_root() {
  cd "$(dirname "$0")/.." && pwd
}

die() {
  echo "$*" >&2
  exit 2
}

reject_audio8_source() {
  local value
  value="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$value" in
    *opena8dj*|*open\ audio\ 8*|*audio\ 8\ dj*|*org.opena8dj.audio8dj*)
      die "known-good output source must not be OpenA8DJ/Audio 8: $1"
      ;;
  esac
}

root="$(repo_root)"
execute=0
route_only=0
candidate=""
known_good_output_device=""
known_good_output_device_uid=""
capture_device=""
capture_channels="1,2"
reference_wav=""
music_file=""
pair="A"
seconds="12"
rate="48000"
buffer="512"
target_peak_db="-16"
run_dir=""
skip_build=0
skip_known_good=0
leave_loaded=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --execute) execute=1; shift ;;
    --route-only) route_only=1; shift ;;
    --candidate) candidate="$2"; shift 2 ;;
    --known-good-output-device) known_good_output_device="$2"; shift 2 ;;
    --known-good-output-device-uid) known_good_output_device_uid="$2"; shift 2 ;;
    --capture-device) capture_device="$2"; shift 2 ;;
    --capture-channels) capture_channels="$2"; shift 2 ;;
    --reference-wav) reference_wav="$2"; shift 2 ;;
    --music-file) music_file="$2"; shift 2 ;;
    --pair) pair="$2"; shift 2 ;;
    --seconds) seconds="$2"; shift 2 ;;
    --rate) rate="$2"; shift 2 ;;
    --buffer) buffer="$2"; shift 2 ;;
    --target-peak-db) target_peak_db="$2"; shift 2 ;;
    --run-dir) run_dir="$2"; shift 2 ;;
    --skip-build) skip_build=1; shift ;;
    --skip-known-good) skip_known_good=1; shift ;;
    --leave-loaded) leave_loaded=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -n "$capture_device" ] || die "--capture-device is required"
[ -n "$run_dir" ] || run_dir="local-analysis/physical-superiority-window/$(date -u +%Y%m%dT%H%M%SZ)"
case "$run_dir" in
  /*) ;;
  *) run_dir="$root/$run_dir" ;;
esac
mkdir -p "$run_dir"

if [ "$skip_known_good" -ne 1 ]; then
  [ -n "$reference_wav" ] || die "--reference-wav is required unless --skip-known-good is used"
  if [ -z "$known_good_output_device" ] && [ -z "$known_good_output_device_uid" ]; then
    die "--known-good-output-device or --known-good-output-device-uid is required"
  fi
fi
if [ -n "$known_good_output_device" ]; then
  reject_audio8_source "$known_good_output_device"
fi
if [ -n "$known_good_output_device_uid" ]; then
  reject_audio8_source "$known_good_output_device_uid"
fi

if [ "$execute" -eq 1 ] && [ "$route_only" -ne 1 ]; then
  [ -n "$candidate" ] || die "--candidate is required for full execution"
  [ -d "$candidate" ] || die "candidate bundle not found: $candidate"
fi
if [ -n "$music_file" ]; then
  case "$music_file" in
    /*) ;;
    *) music_file="$root/$music_file" ;;
  esac
  [ -f "$music_file" ] || die "music-file not found: $music_file"
fi

manifest="$run_dir/window-manifest.txt"
{
  echo "schema=opena8djcpp.physical-superiority-window.v1"
  echo "worktree=$root"
  echo "branch=$(git -C "$root" branch --show-current)"
  echo "commit=$(git -C "$root" rev-parse --short HEAD)"
  echo "execute=$execute"
  echo "route_only=$route_only"
  echo "candidate=${candidate:-}"
  echo "known_good_output_device=${known_good_output_device:-}"
  echo "known_good_output_device_uid=${known_good_output_device_uid:-}"
  echo "capture_device=$capture_device"
  echo "capture_channels=$capture_channels"
  echo "reference_wav=${reference_wav:-}"
  echo "music_file=${music_file:-}"
  echo "pair=$pair"
  echo "seconds=$seconds"
  echo "rate=$rate"
  echo "buffer=$buffer"
  echo "target_peak_db=$target_peak_db"
  echo "skip_known_good=$skip_known_good"
  echo "leave_loaded=$leave_loaded"
  echo "run_dir=$run_dir"
} > "$manifest"

if [ "$execute" -ne 1 ]; then
  {
    echo "PHYSICAL_SUPERIORITY_WINDOW: PLAN_ONLY"
    echo "No hardware/audio action was run. Add --execute for a locked physical window."
    echo "Required physical order:"
    echo "1 known-good non-Audio8 route -> iRig"
    echo "2 candidate HAL safety install/reload"
    echo "3 Audio 8 DJ soundcheck with CPU/stream evidence"
    echo "4 native C++ WAV quality analysis"
    echo "5 promotion-readiness evaluator"
    echo "run_dir=$run_dir"
  } | tee "$run_dir/summary.txt"
  exit 0
fi

# shellcheck source=scripts/hardware-lock-lib.sh
source "$root/scripts/hardware-lock-lib.sh"
opena8dj_acquire_hardware_lock \
  "$root" \
  "physical-superiority-window" \
  "$run_dir" \
  "known-good route playback/capture, optional HAL install/reload, Audio 8 DJ playback/capture, CoreAudio enumeration" \
  "default-device-change,sample-rate-change,buffer-change,USB-reset,system-reboot,Traktor-launch"
trap opena8dj_release_hardware_lock EXIT

cleanup_candidate() {
  if [ "$leave_loaded" -eq 0 ] && [ "$route_only" -ne 1 ] && [ -n "$candidate" ]; then
    "$root/scripts/audio-stack-guard" \
      --recover \
      --unload-opena8dj \
      --wait 3 \
      --enumeration-timeout 8 \
      --min-idle-pct 20 \
      --run-dir "$run_dir/final-unload-guard" \
      > "$run_dir/final-unload-guard.log" 2>&1 || true
  fi
}
trap 'cleanup_candidate; opena8dj_release_hardware_lock' EXIT

if [ "$skip_build" -ne 1 ]; then
  make -C "$root" build/audio-wav-play build/audio-record build/opena8dj-control >/dev/null
  cmake -S "$root" -B "$root/build/cpp-release" -DCMAKE_BUILD_TYPE=Release >/dev/null
  cmake --build "$root/build/cpp-release" --target opena8djcpp_soundcheck_wav_quality >/dev/null
fi

if [ "$skip_known_good" -ne 1 ]; then
  known_good_args=(
    "$root/scripts/run-known-good-route-soundcheck"
    --run-dir "$run_dir/known-good-route"
    --capture-device "$capture_device"
    --capture-channels "$capture_channels"
    --reference-wav "$reference_wav"
    --seconds "$seconds"
    --skip-build
  )
  if [ -n "$known_good_output_device_uid" ]; then
    known_good_args+=(--output-device-uid "$known_good_output_device_uid")
  else
    known_good_args+=(--output-device "$known_good_output_device")
  fi
  "${known_good_args[@]}"
fi

if [ "$route_only" -eq 1 ]; then
  {
    echo "PHYSICAL_SUPERIORITY_WINDOW: ROUTE_ONLY_PASS"
    echo "known_good_route=$run_dir/known-good-route"
    echo "run_dir=$run_dir"
  } | tee "$run_dir/summary.txt"
  exit 0
fi

"$root/scripts/test-hal-candidate-safety" \
  --candidate "$candidate" \
  --cycles 1 \
  --leave-loaded \
  --wait 8 \
  --enumeration-timeout 8 \
  --min-idle-pct 20 \
  --run-dir "$run_dir/hal-candidate-safety"

soundcheck_args=(
  "$root/scripts/run-soundcheck"
  --run-dir "$run_dir/cpp-soundcheck"
  --capture-device "$capture_device"
  --capture-channels "$capture_channels"
  --pair "$pair"
  --rate "$rate"
  --buffer "$buffer"
  --seconds "$seconds"
  --mode dense
  --target-peak-db "$target_peak_db"
  --max-lag 360000
  --min-alignment 0.98
  --min-snr-db 35
  --max-clicks 0
  --max-lag-jumps 0
  --max-mid-band-residual-ratio 1.36
  --max-high-band-residual-ratio 1.35
  --max-quiet-mid-band-noise-dbfs -58
  --stream-stats-snapshots
  --audio-stack-recover-on-fail
  --audio-stack-unload-on-recover
  --skip-build
)
if [ -n "$music_file" ]; then
  soundcheck_args+=(--music-file "$music_file")
fi
"${soundcheck_args[@]}"

"$root/build/cpp-release/opena8djcpp_soundcheck_wav_quality" "$run_dir/cpp-soundcheck" \
  > "$run_dir/cpp-soundcheck/native-quality.json" \
  2> "$run_dir/cpp-soundcheck/native-quality.err"

set +e
"$root/scripts/evaluate-promotion-readiness.py" \
  --music "$run_dir/cpp-soundcheck/metrics.json" \
  --cpu "$run_dir/cpp-soundcheck/cpu-profile.tsv" \
  --json-out "$run_dir/promotion-readiness.json" \
  > "$run_dir/promotion-readiness.stdout" \
  2> "$run_dir/promotion-readiness.stderr"
promotion_rc=$?
set -e

{
  echo "PHYSICAL_SUPERIORITY_WINDOW: DONE"
  echo "known_good_route=$run_dir/known-good-route"
  echo "hal_candidate_safety=$run_dir/hal-candidate-safety"
  echo "cpp_soundcheck=$run_dir/cpp-soundcheck"
  echo "native_quality=$run_dir/cpp-soundcheck/native-quality.json"
  echo "promotion_readiness=$run_dir/promotion-readiness.json"
  echo "promotion_rc=$promotion_rc"
  echo "leave_loaded=$leave_loaded"
  echo "run_dir=$run_dir"
} | tee "$run_dir/summary.txt"

if [ "$promotion_rc" -eq 0 ]; then
  exit 0
fi
exit 1
