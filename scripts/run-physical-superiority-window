#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
usage: scripts/run-physical-superiority-window --run-dir DIR --capture-device NAME --reference-wav PATH [options]

Plans or executes the lock-gated physical evidence window needed before any
claim that the C++ line beats mainline. By default this is dry-run only.

Execution sequence when --execute is present:
  1. acquire the global hardware lock for the whole window;
  2. validate a known-good non-Audio8 source through the iRig capture route;
  3. install/reload the explicit mainline HAL candidate and run soundcheck;
  4. install/reload the explicit C++ HAL candidate and run soundcheck;
  5. run native C++ WAV quality analysis for both captures;
  6. compare same-session mainline vs C++ physical metrics;
  7. run promotion-readiness evaluation against the C++ evidence;
  8. unload the active candidate unless --leave-loaded is present.

This script does not change default devices, sample rate of arbitrary devices,
USB state, or reboot the system. It refuses to run physical work without
--execute.

Required for full execution:
  --execute
  --mainline-candidate PATH
  --candidate PATH
  --known-good-output-device NAME or --known-good-output-device-uid UID
  --capture-device NAME
  --reference-wav PATH

Options:
  --execute                         Actually run the physical window
  --route-only                      Execute only the known-good route check
  --candidate-only                  Diagnostic: skip same-session mainline run
  --mainline-candidate PATH         Mainline C HAL bundle for same-session A/B
  --candidate PATH                  HAL candidate bundle for C++ run
  --known-good-output-device NAME   Explicit non-Audio8 source for route check
  --known-good-output-device-uid UID Explicit non-Audio8 source UID
  --capture-device NAME             Capture device, normally "iRig Stream"
  --capture-channels LIST           Capture channels, default 1,2
  --reference-wav PATH              Reference WAV for known-good route check
  --music-file PATH                 Music WAV/AIFF/etc for Audio 8 soundcheck
  --pair A|B|C|D                    Audio 8 pair, default A
  --seconds N                       Seconds for route and Audio 8 checks, default 12
  --rate N                          Audio 8 sample rate, default 48000
  --buffer N                        Audio 8 buffer, default 512
  --target-peak-db DB               Fixture target peak, default -16
  --run-dir DIR                     Evidence directory
  --skip-build                      Reuse existing built tools
  --skip-known-good                 Skip route validation; diagnostic only
  --allow-built-in-output-acoustic-diagnostic
                                    Allow built-in speaker/acoustic route;
                                    diagnostic only, never promotion evidence
  --leave-loaded                    Leave HAL candidate loaded after success
  -h, --help                        Show this help
USAGE
}

repo_root() {
  cd "$(dirname "$0")/.." && pwd
}

die() {
  echo "$*" >&2
  exit 2
}

reject_audio8_source() {
  local value
  value="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$value" in
    *opena8dj*|*open\ audio\ 8*|*audio\ 8\ dj*|*org.opena8dj.audio8dj*)
      die "known-good output source must not be OpenA8DJ/Audio 8: $1"
      ;;
  esac
}

root="$(repo_root)"
execute=0
route_only=0
candidate_only=0
mainline_candidate=""
candidate=""
known_good_output_device=""
known_good_output_device_uid=""
capture_device=""
capture_channels="1,2"
reference_wav=""
music_file=""
pair="A"
seconds="12"
rate="48000"
buffer="512"
target_peak_db="-16"
run_dir=""
skip_build=0
skip_known_good=0
allow_built_in_output_acoustic_diagnostic=0
leave_loaded=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    --execute) execute=1; shift ;;
    --route-only) route_only=1; shift ;;
    --candidate-only) candidate_only=1; shift ;;
    --mainline-candidate) mainline_candidate="$2"; shift 2 ;;
    --candidate) candidate="$2"; shift 2 ;;
    --known-good-output-device) known_good_output_device="$2"; shift 2 ;;
    --known-good-output-device-uid) known_good_output_device_uid="$2"; shift 2 ;;
    --capture-device) capture_device="$2"; shift 2 ;;
    --capture-channels) capture_channels="$2"; shift 2 ;;
    --reference-wav) reference_wav="$2"; shift 2 ;;
    --music-file) music_file="$2"; shift 2 ;;
    --pair) pair="$2"; shift 2 ;;
    --seconds) seconds="$2"; shift 2 ;;
    --rate) rate="$2"; shift 2 ;;
    --buffer) buffer="$2"; shift 2 ;;
    --target-peak-db) target_peak_db="$2"; shift 2 ;;
    --run-dir) run_dir="$2"; shift 2 ;;
    --skip-build) skip_build=1; shift ;;
    --skip-known-good) skip_known_good=1; shift ;;
    --allow-built-in-output-acoustic-diagnostic) allow_built_in_output_acoustic_diagnostic=1; shift ;;
    --leave-loaded) leave_loaded=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[ -n "$capture_device" ] || die "--capture-device is required"
[ -n "$run_dir" ] || run_dir="local-analysis/physical-superiority-window/$(date -u +%Y%m%dT%H%M%SZ)"
case "$run_dir" in
  /*) ;;
  *) run_dir="$root/$run_dir" ;;
esac
mkdir -p "$run_dir"

if [ "$skip_known_good" -ne 1 ]; then
  [ -n "$reference_wav" ] || die "--reference-wav is required unless --skip-known-good is used"
  if [ -z "$known_good_output_device" ] && [ -z "$known_good_output_device_uid" ]; then
    die "--known-good-output-device or --known-good-output-device-uid is required"
  fi
fi
if [ -n "$known_good_output_device" ]; then
  reject_audio8_source "$known_good_output_device"
fi
if [ -n "$known_good_output_device_uid" ]; then
  reject_audio8_source "$known_good_output_device_uid"
fi

if [ "$execute" -eq 1 ] && [ "$route_only" -ne 1 ]; then
  if [ "$candidate_only" -ne 1 ]; then
    [ -n "$mainline_candidate" ] || die "--mainline-candidate is required for full same-session execution"
    [ -d "$mainline_candidate" ] || die "mainline candidate bundle not found: $mainline_candidate"
  fi
  [ -n "$candidate" ] || die "--candidate is required for full execution"
  [ -d "$candidate" ] || die "candidate bundle not found: $candidate"
fi
if [ -n "$music_file" ]; then
  case "$music_file" in
    /*) ;;
    *) music_file="$root/$music_file" ;;
  esac
  [ -f "$music_file" ] || die "music-file not found: $music_file"
fi

manifest="$run_dir/window-manifest.txt"
{
  echo "schema=opena8djcpp.physical-superiority-window.v1"
  echo "worktree=$root"
  echo "branch=$(git -C "$root" branch --show-current)"
  echo "commit=$(git -C "$root" rev-parse --short HEAD)"
  echo "execute=$execute"
  echo "route_only=$route_only"
  echo "candidate_only=$candidate_only"
  echo "mainline_candidate=${mainline_candidate:-}"
  echo "candidate=${candidate:-}"
  echo "known_good_output_device=${known_good_output_device:-}"
  echo "known_good_output_device_uid=${known_good_output_device_uid:-}"
  echo "capture_device=$capture_device"
  echo "capture_channels=$capture_channels"
  echo "reference_wav=${reference_wav:-}"
  echo "music_file=${music_file:-}"
  echo "pair=$pair"
  echo "seconds=$seconds"
  echo "rate=$rate"
  echo "buffer=$buffer"
  echo "target_peak_db=$target_peak_db"
  echo "skip_known_good=$skip_known_good"
  echo "allow_built_in_output_acoustic_diagnostic=$allow_built_in_output_acoustic_diagnostic"
  echo "leave_loaded=$leave_loaded"
  echo "run_dir=$run_dir"
} > "$manifest"

if [ "$execute" -ne 1 ]; then
  {
    echo "PHYSICAL_SUPERIORITY_WINDOW: PLAN_ONLY"
    echo "No hardware/audio action was run. Add --execute for a locked physical window."
    echo "Required physical order:"
    echo "1 known-good non-Audio8 route -> iRig"
    echo "2 mainline HAL safety install/reload and soundcheck"
    echo "3 C++ HAL safety install/reload and soundcheck"
    echo "4 native C++ WAV quality analysis for both runs"
    echo "5 same-session physical comparison"
    echo "6 promotion-readiness evaluator"
    echo "run_dir=$run_dir"
  } | tee "$run_dir/summary.txt"
  exit 0
fi

if [ "$skip_build" -ne 1 ]; then
  make -C "$root" build/audio-list >/dev/null
fi

preflight_args=(
  "$root/scripts/physical-window-preflight"
  --run-dir "$run_dir"
  --capture-device "$capture_device"
  --capture-channels "$capture_channels"
  --reference-wav "$reference_wav"
  --mainline-candidate "$mainline_candidate"
  --candidate "$candidate"
  --json-out "$run_dir/physical-window-preflight.json"
)
if [ "$route_only" -eq 1 ]; then
  preflight_args+=(--route-only)
fi
if [ "$candidate_only" -eq 1 ]; then
  preflight_args+=(--candidate-only)
fi
if [ "$skip_known_good" -eq 1 ]; then
  preflight_args+=(--skip-known-good)
fi
if [ "$allow_built_in_output_acoustic_diagnostic" -eq 1 ]; then
  preflight_args+=(--allow-built-in-output-acoustic-diagnostic)
fi
if [ -n "$known_good_output_device_uid" ]; then
  preflight_args+=(--known-good-output-device-uid "$known_good_output_device_uid")
else
  preflight_args+=(--known-good-output-device "$known_good_output_device")
fi
if [ -n "$music_file" ]; then
  preflight_args+=(--music-file "$music_file")
fi
if ! "${preflight_args[@]}" > "$run_dir/physical-window-preflight.stdout" 2> "$run_dir/physical-window-preflight.stderr"; then
  {
    echo "PHYSICAL_SUPERIORITY_WINDOW: PREFLIGHT_FAIL"
    echo "preflight=$run_dir/physical-window-preflight.json"
    echo "preflight_stdout=$run_dir/physical-window-preflight.stdout"
    echo "preflight_stderr=$run_dir/physical-window-preflight.stderr"
    echo "run_dir=$run_dir"
  } | tee "$run_dir/summary.txt"
  exit 2
fi

# shellcheck source=scripts/hardware-lock-lib.sh
source "$root/scripts/hardware-lock-lib.sh"
opena8dj_acquire_hardware_lock \
  "$root" \
  "physical-superiority-window" \
  "$run_dir" \
  "known-good route playback/capture, mainline HAL install/reload, C++ HAL install/reload, Audio 8 DJ playback/capture, CoreAudio enumeration" \
  "default-device-change,sample-rate-change,buffer-change,USB-reset,system-reboot,Traktor-launch"
trap opena8dj_release_hardware_lock EXIT

cleanup_candidate() {
  if [ "$leave_loaded" -eq 0 ] && [ "$route_only" -ne 1 ] && [ -n "$candidate" ]; then
    "$root/scripts/audio-stack-guard" \
      --force-unload-opena8dj \
      --wait 3 \
      --enumeration-timeout 8 \
      --min-idle-pct 20 \
      --run-dir "$run_dir/final-unload-guard" \
      > "$run_dir/final-unload-guard.log" 2>&1 || true
  fi
}
trap 'cleanup_candidate; opena8dj_release_hardware_lock' EXIT

unload_active_hal() {
  "$root/scripts/audio-stack-guard" \
    --force-unload-opena8dj \
    --wait 3 \
    --enumeration-timeout 8 \
    --min-idle-pct 20 \
    --run-dir "$1" \
    > "$1.log" 2>&1 || true
}

if [ "$skip_build" -ne 1 ]; then
  make -C "$root" build/audio-wav-play build/audio-record build/opena8dj-control >/dev/null
  cmake -S "$root" -B "$root/build/cpp-release" -DCMAKE_BUILD_TYPE=Release >/dev/null
  cmake --build "$root/build/cpp-release" \
    --target opena8djcpp_soundcheck_wav_quality opena8djcpp_physical_run_compare >/dev/null
fi

if [ "$skip_known_good" -ne 1 ]; then
  known_good_args=(
    "$root/scripts/run-known-good-route-soundcheck"
    --run-dir "$run_dir/known-good-route"
    --capture-device "$capture_device"
    --capture-channels "$capture_channels"
    --reference-wav "$reference_wav"
    --seconds "$seconds"
    --skip-build
  )
  if [ -n "$known_good_output_device_uid" ]; then
    known_good_args+=(--output-device-uid "$known_good_output_device_uid")
  else
    known_good_args+=(--output-device "$known_good_output_device")
  fi
  if [ "$allow_built_in_output_acoustic_diagnostic" -eq 1 ]; then
    known_good_args+=(--allow-built-in-output-acoustic-diagnostic)
  fi
  "${known_good_args[@]}"
fi
known_good_rc=0
if [ "$skip_known_good" -eq 1 ]; then
  known_good_rc=1
  printf '{"schema":"opena8djcpp.known-good-route.v1","result":"FAIL","readiness_claim":"BLOCKED_KNOWN_GOOD_ROUTE_SKIPPED"}\n' \
    > "$run_dir/known-good-route-skipped.json"
fi

if [ "$route_only" -eq 1 ]; then
  {
    if [ "$known_good_rc" -eq 0 ]; then
      echo "PHYSICAL_SUPERIORITY_WINDOW: ROUTE_ONLY_PASS"
    else
      echo "PHYSICAL_SUPERIORITY_WINDOW: ROUTE_ONLY_BLOCKED"
    fi
    echo "known_good_route=$run_dir/known-good-route"
    echo "known_good_rc=$known_good_rc"
    echo "run_dir=$run_dir"
  } | tee "$run_dir/summary.txt"
  exit "$known_good_rc"
fi

last_soundcheck_rc=0

run_audio8_soundcheck() {
  local label="$1"
  local bundle="$2"
  local out_dir="$3"

  mkdir -p "$out_dir"
  local hal_safety_rc=0
  set +e
  "$root/scripts/test-hal-candidate-safety" \
    --candidate "$bundle" \
    --cycles 1 \
    --leave-loaded \
    --wait 8 \
    --enumeration-timeout 8 \
    --min-idle-pct 20 \
    --run-dir "$run_dir/$label-hal-candidate-safety"
  hal_safety_rc=$?
  set -e
  if [ "$hal_safety_rc" -ne 0 ]; then
    {
      echo "label=$label"
      echo "hal_safety_rc=$hal_safety_rc"
      echo "soundcheck_rc=124"
      echo "native_rc=124"
      echo "out_dir=$out_dir"
      echo "soundcheck_skipped=hal_candidate_safety_failed"
    } > "$out_dir/window-soundcheck-status.txt"
    last_soundcheck_rc=124
    return 0
  fi

  local soundcheck_args=(
    "$root/scripts/run-soundcheck"
    --run-dir "$out_dir"
    --capture-device "$capture_device"
    --capture-channels "$capture_channels"
    --pair "$pair"
    --rate "$rate"
    --buffer "$buffer"
    --seconds "$seconds"
    --mode dense
    --target-peak-db "$target_peak_db"
    --max-lag 360000
    --min-alignment 0.98
    --min-snr-db 35
    --max-clicks 0
    --max-lag-jumps 0
    --max-mid-band-residual-ratio 1.36
    --max-high-band-residual-ratio 1.35
    --max-quiet-mid-band-noise-dbfs -58
    --stream-stats-snapshots
    --audio-stack-recover-on-fail
    --audio-stack-unload-on-recover
    --skip-build
  )
  if [ -n "$music_file" ]; then
    soundcheck_args+=(--music-file "$music_file")
  fi
  local soundcheck_rc=0
  local native_rc=0
  set +e
  "${soundcheck_args[@]}"
  soundcheck_rc=$?
  set -e

  if [ -f "$out_dir/captured.wav" ]; then
    set +e
    "$root/build/cpp-release/opena8djcpp_soundcheck_wav_quality" "$out_dir" \
      > "$out_dir/native-quality.json" \
      2> "$out_dir/native-quality.err"
    native_rc=$?
    set -e
  else
    native_rc=125
    {
      echo "native quality skipped: missing captured.wav"
    } > "$out_dir/native-quality.err"
  fi

  {
    echo "label=$label"
    echo "hal_safety_rc=$hal_safety_rc"
    echo "soundcheck_rc=$soundcheck_rc"
    echo "native_rc=$native_rc"
    echo "out_dir=$out_dir"
  } > "$out_dir/window-soundcheck-status.txt"

  last_soundcheck_rc="$soundcheck_rc"
  return 0
}

mainline_soundcheck_rc=0
cpp_soundcheck_rc=0

if [ "$candidate_only" -ne 1 ]; then
  run_audio8_soundcheck "mainline" "$mainline_candidate" "$run_dir/mainline-soundcheck"
  mainline_soundcheck_rc="$last_soundcheck_rc"
  unload_active_hal "$run_dir/post-mainline-unload-guard"
fi

run_audio8_soundcheck "cpp" "$candidate" "$run_dir/cpp-soundcheck"
cpp_soundcheck_rc="$last_soundcheck_rc"

same_session_rc=0
if [ "$candidate_only" -ne 1 ] && [ -f "$run_dir/cpp-soundcheck/metrics.json" ] && [ -f "$run_dir/mainline-soundcheck/metrics.json" ]; then
  set +e
  "$root/build/cpp-release/opena8djcpp_physical_run_compare" \
    --candidate "$run_dir/cpp-soundcheck" \
    --baseline "$run_dir/mainline-soundcheck" \
    > "$run_dir/same-session-physical-compare.json"
  compare_tool_rc=$?
  set -e
  [ "$compare_tool_rc" -eq 0 ] || same_session_rc=1
  same_session_result="$(/usr/bin/python3 - "$run_dir/same-session-physical-compare.json" <<'PY'
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as handle:
        print(json.load(handle).get("result", "FAIL"))
except Exception:
    print("FAIL")
PY
)"
  [ "$same_session_result" = "PASS" ] || same_session_rc=1
elif [ "$candidate_only" -ne 1 ]; then
  printf '{"schema":"opena8djcpp.physical-run-compare.v2","mode":"same_session","result":"FAIL","branch_promotion_supported":false,"readiness_claim":"BLOCKED_MISSING_MAINLINE_OR_CPP_METRICS"}\n' \
    > "$run_dir/same-session-physical-compare.json"
  same_session_rc=1
else
  printf '{"schema":"opena8djcpp.physical-run-compare.v2","mode":"candidate_only","result":"FAIL","branch_promotion_supported":false,"readiness_claim":"BLOCKED_NO_SAME_SESSION_MAINLINE"}\n' \
    > "$run_dir/same-session-physical-compare.json"
  same_session_rc=1
fi

set +e
"$root/scripts/evaluate-promotion-readiness.py" \
  --music "$run_dir/cpp-soundcheck/metrics.json" \
  --cpu "$run_dir/cpp-soundcheck/cpu-profile.tsv" \
  --same-session-compare "$run_dir/same-session-physical-compare.json" \
  --json-out "$run_dir/promotion-readiness.json" \
  > "$run_dir/promotion-readiness.stdout" \
  2> "$run_dir/promotion-readiness.stderr"
promotion_rc=$?
set -e

{
  echo "PHYSICAL_SUPERIORITY_WINDOW: DONE"
  echo "known_good_route=$run_dir/known-good-route"
  echo "known_good_rc=$known_good_rc"
  if [ "$candidate_only" -ne 1 ]; then
    echo "mainline_hal_candidate_safety=$run_dir/mainline-hal-candidate-safety"
    echo "mainline_soundcheck=$run_dir/mainline-soundcheck"
    echo "mainline_native_quality=$run_dir/mainline-soundcheck/native-quality.json"
    echo "mainline_soundcheck_rc=$mainline_soundcheck_rc"
  fi
  echo "cpp_hal_candidate_safety=$run_dir/cpp-hal-candidate-safety"
  echo "cpp_soundcheck=$run_dir/cpp-soundcheck"
  echo "cpp_native_quality=$run_dir/cpp-soundcheck/native-quality.json"
  echo "cpp_soundcheck_rc=$cpp_soundcheck_rc"
  echo "same_session_compare=$run_dir/same-session-physical-compare.json"
  echo "same_session_rc=$same_session_rc"
  echo "promotion_readiness=$run_dir/promotion-readiness.json"
  echo "promotion_rc=$promotion_rc"
  echo "leave_loaded=$leave_loaded"
  echo "run_dir=$run_dir"
} | tee "$run_dir/summary.txt"

if [ "$promotion_rc" -eq 0 ] && [ "$same_session_rc" -eq 0 ] && [ "$known_good_rc" -eq 0 ] && [ "$mainline_soundcheck_rc" -eq 0 ] && [ "$cpp_soundcheck_rc" -eq 0 ]; then
  exit 0
fi
exit 1
